# Common OTBN module configuration

rsource "Kconfig.wolfssl"
rsource "Kconfig.mbedtls"

module = LINKEDSEMI_OTBN
module-str = "LinkedSemi OTBN"
source "subsys/logging/Kconfig.template.log_config"

config LINKEDSEMI_OTBN
	bool
	help
	  Internal flag indicating that the OTBN hardware module is used.
	  Selected automatically when mbedtls or wolfssl OTBN support is enabled.


config LS_OTBN_DELEGATION
	bool
	help
	  Internal flag: the OTBN delegation bus (otbn_delegation.c) is built into
	  this image. Selected by either side below.

config LS_OTBN_DELEGATION_CLIENT
	bool "OTBN delegation: this core sends the requests"
	default n
	select LS_OTBN_DELEGATION
	help
	  Build the OTBN delegation channel in client mode: operations are
	  forwarded over the otbn_crypto mailbox to the peer core, which owns the
	  OTBN. The channel is crypto-library agnostic -- a library's own
	  delegation switch (mbedtls', wolfssl's) selects this one, so
	  applications normally do not set it directly. Note that the client does
	  not need this core's OTBN: only the server side drives it.

config LS_OTBN_DELEGATION_SERVER
	bool "OTBN delegation: this core executes the requests"
	default n
	select LS_OTBN_DELEGATION
	help
	  Build the OTBN delegation channel in server mode: this core answers the
	  peer's requests from its own OTBN, so it needs the local OTBN support of
	  every operation family it is expected to serve.


config LS_OTBN_OPERATION_TIMEOUT_MS
	int "OTBN operation timeout in milliseconds"
	default 15000
	help
	  Maximum time in milliseconds to wait for a non-keygen OTBN operation
	  to complete. This timeout applies to hash, ECDSA, SM2, RSA encrypt/
	  verify/sign/decrypt, and other OTBN commands. Must be large enough
	  for the slowest non-keygen operation on the target platform.

config LS_OTBN_KEYGEN_OPERATION_TIMEOUT_MS
	int "OTBN RSA keygen operation timeout in milliseconds"
	default 180000
	help
	  Maximum time in milliseconds to wait for an RSA key generation
	  operation to complete. RSA keygen involves random prime searching
	  with repeated primality tests and can take much longer than other
	  operations: RSA-2048 keygen worst case is ~72 s, RSA-4096 keygen
	  may take several minutes. This timeout is only used when the active
	  firmware is OTBN_FIRMWARE_RSA_KEYGEN.

config LS_OTBN_RSA_KEYGEN
	bool "OTBN RSA key generation module"
	default n
	select LINKEDSEMI_OTBN
	help
	  Build the OTBN-backed RSA key generation module
	  (otbn_rsa_keygen.c). Enable it for configurations that generate RSA
	  keys; the API is otbn_rsa_keygen() plus the RNG-free helpers declared
	  in otbn_rsa_keygen.h. The module references the RSA keygen firmware
	  image, so enabling it adds that image to the build.
