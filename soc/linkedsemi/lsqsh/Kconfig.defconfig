if SOC_SERIES_LSQSH

config SOC
    default "lsqsh"

config RISCV_HAS_PLIC
	default n

config RISCV_HAS_CLIC
	default y

config XUANTIE_E906_CLIC
	bool
	default y

config RISCV_MCAUSE_EXCEPTION_MASK
	default 0xfff

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@1,clock-frequency) if $(dt_path_enabled,/cpus/cpu@1)
	default $(dt_node_int_prop_int,/cpus/cpu@2,clock-frequency) if $(dt_path_enabled,/cpus/cpu@2)
	default 0

config NUM_IRQS
	default 176

config MAIN_STACK_SIZE
	default 2048

config ICACHE_LINE_SIZE
	default 32

config DCACHE_LINE_SIZE
	default 32

config IOPMP
	bool "IOPMP"
	default y

config RV_BOOT_HART_MRADDR
	hex
	default 0x1000000

choice CACHE_TYPE
	default EXTERNAL_CACHE
endchoice

config SOC_EARLY_INIT_HOOK
	default y

config SOC_LATE_INIT_HOOK
	default y

if NETWORKING

config NET_L2_ETHERNET
	default y

config NET_DRIVERS
	default y

config MDIO
	default y

endif # NETWORKING

if CACHE
if DCACHE

if NETWORKING
config NET_BUF_ALIGNMENT
	default DCACHE_LINE_SIZE
endif # NETWORKING

if FAT_FILESYSTEM_ELM
config FS_FATFS_WINDOW_ALIGNMENT
	default DCACHE_LINE_SIZE
endif # FAT_FILESYSTEM_ELM

endif # DCACHE
endif # CACHE

config NUM_USE_CPU
	int "running CPU number"
	range 1 2
	default 2

config NUM_OS
	int "running OS number"
	range 1 2
	default 2

if ((NUM_USE_CPU=2) && $(dt_path_enabled,/cpus/cpu@1))
	config BOOT_CPU2
		bool "BOOT_CPU2"
		default n
endif

config IMAGE_HEADER
	bool "IMAGE_HEADER"
	default n

config CPU2_LOAD_ADDR
	hex "CPU2_LOAD_ADDR"
	default 0x8800000

config CPU2_BOOT_ADDR
	hex "CPU2_BOOT_ADDR"
	default 0x8800000

config FLASH
	default y

config FLASH_PROXY_SERVER
	bool "FLASH_PROXY_SERVER"
	depends on $(dt_path_enabled,/cpus/cpu@1)
	depends on (NUM_USE_CPU > 1)
	default y

if FLASH_PROXY_SERVER
	config MBOX
		default y

	config FLASH
		default y

	config FLASH_JESD216_API
		default y
endif

config CRC
	default y

config USERSPACE
	default n

config RISCV_PMP
	default y
	
config PMP_SLOTS
	default 16

config PMP_GRANULARITY
	default 128

config PMP_NO_NA4
	default y

config RISCV_SOC_HAS_ISR_STACKING
	default y

config PSRAM
	bool "PSRAM"
	default n

config COMMON_LIBC_MALLOC_LSQSH
	bool "COMMON_LIBC_MALLOC_LSQSH"
	default n

config NEWLIB_LIBC_MALLOC_LSQSH
	bool "NEWLIB_LIBC_MALLOC_LSQSH"
	default n

if COMMON_LIBC_MALLOC_LSQSH

config COMMON_LIBC_MALLOC_ARENA_SIZE
	int "COMMON_LIBC_MALLOC_ARENA_SIZE"
	default 0

config COMMON_LIBC_MALLOC_ARENA_2_SIZE
	int "COMMON_LIBC_MALLOC_ARENA_2_SIZE"
	default 0

config COMMON_LIBC_MALLOC
	default n

endif

if NEWLIB_LIBC_MALLOC_LSQSH

config NEWLIB_LIBC_MALLOC_ARENA_SIZE
	int "NEWLIB_LIBC_MALLOC_ARENA_SIZE"
	default 0

config NEWLIB_LIBC_MALLOC_ARENA_2_SIZE
	int "NEWLIB_LIBC_MALLOC_ARENA_2_SIZE"
	default 0

config NEWLIB_LIBC_CALLOC
	bool "Common C library calloc"
	depends on NEWLIB_LIBC_MALLOC_LSQSH
	default n if MINIMAL_LIBC
	default y
	help
	  Enable the common C library trivial implementation of calloc,
	  which forwards to malloc and memset.

config NEWLIB_LIBC_REALLOCARRAY
	bool "Common C library reallocarray"
	depends on NEWLIB_LIBC_MALLOC_LSQSH
	default n if MINIMAL_LIBC
	default y
	help
	  Enable the common C library trivial implementation of
	  reallocarray, which forwards to realloc.

config COMMON_LIBC_MALLOC
	default n

endif

endif
