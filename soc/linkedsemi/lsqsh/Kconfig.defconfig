config NUM_USE_CPU
	int "running CPU number"
	range 1 2
	default 2

config NUM_OS
	int "running OS number"
	range 1 2
	default 2

if (NUM_USE_CPU=2)
	if $(dt_path_enabled,/cpus/cpu@1)
		config BOOT_CPU2
			bool "BOOT_CPU2"
			default n

	if (NUM_OS=2)
		config FLASH_OP_DELEGATION_SERVER
			default y
	endif # (NUM_OS=2)
endif # (NUM_USE_CPU=2)

	config MBOX
		default y
endif

