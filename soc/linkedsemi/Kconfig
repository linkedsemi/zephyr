
if SOC_FAMILY_LS_MCU

config ESPI_LPC
    bool
    default y
    select PCC

config ESPI_LPC_MBOX
    bool "espi lpc mbox for dual core cooperation"
    default n
    depends on ESPI_LPC

config ESPI_LPC_HOST_VUART
    bool "Linkedsemi ESPI/LPC HOST VUART"
    default y
    depends on DT_HAS_LINKEDSEMI_LS_HOST_VUART_ENABLED
    depends on ESPI_LPC

    help
        Enable Host-side VUART

config ESPI_LPC_HOST_KCS
    bool "Linkedsemi ESPI/LPC HOST KCS"
    default y
    depends on DT_HAS_LINKEDSEMI_LS_HOST_KCS_ENABLED
    depends on ESPI_LPC

    help
        Enable Host-side KCS

config ESPI_LPC_SIO
    bool "Linkedsemi ESPI/LPC sio driver"
    default y
    depends on DT_HAS_LINKEDSEMI_LS_SIO_ENABLED
    help
        Enable Linkedsemi ESPI/LPC sio driver.

config ESPI_LPC_HOST_MMBI
    bool "Linkedsemi ESPI/LPC mmbi driver"
    default y
    depends on DT_HAS_LINKEDSEMI_LS_HOST_MMBI_ENABLED
    help
        Enable Linkedsemi ESPI/LPC mmbi driver.

config ESPI_LPC_HOST_PCC
    bool "Linkedsemi ESPI/LPC HOST PCC"
    default y
    depends on DT_HAS_LINKEDSEMI_LS_HOST_PCC_ENABLED
    depends on ESPI_LPC

    help
        Enable Host-side PCC

config ESPI_LPC_PCC_FIFO_LENGTH
    int "Linkedsemi ESPI/LPC HOST PCC FIFO length"
    default 128
    depends on ESPI_LPC

    help
        Length of the FIFO for Host-side PCC

config LINKEDSEMI_TPM_WWDT
    bool "LinkedSemi TPM WWDT"
    default n
    depends on SOC_LSQSH

    help
      Enable wwdt1_tpm_init() in lsqsh soc.c
rsource "*/Kconfig"

endif
