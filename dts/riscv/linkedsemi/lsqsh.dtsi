#include <zephyr/dt-bindings/pinctrl/lsqsh-pinctrl.h>
#include <zephyr/dt-bindings/clock/lsqsh_clock.h>
#include <zephyr/dt-bindings/reset/lsqsh_reset.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <mem.h>
#include <freq.h>
#include <dmac_config.h>

#include <zephyr/dt-bindings/memory-attr/memory-attr.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-riscv.h>
#include <qsh.h>

#define CPU_CLOCK      DT_FREQ_M(600)
#define PBUS0123_CLOCK DT_FREQ_M(300)
#define PBUS4_CLOCK    DT_FREQ_M(75)
#define SDHCI_CLOCK    DT_FREQ_M(200)

/ {
    #address-cells = <1>;
    #size-cells = <1>;

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        cpu1: cpu@1 {
            device_type = "cpu";
            compatible = "linkedsemi,riscv";
            riscv,isa = "rv32imafcxp";
            reg = <1>;
            clock-frequency = <CPU_CLOCK>;
            cpu-power-states = <&idle &lp0>;
        };
        cpu2: cpu@2 {
            device_type = "cpu";
            compatible = "linkedsemi,riscv";
            riscv,isa = "rv32imafcxp";
            reg = <2>;
            clock-frequency = <CPU_CLOCK>;
            cpu-power-states = <&idle &lp0>;
            status = "disabled";
        };
    };

    soc {
        compatible = "simpe-bus";
        #address-cells = <1>;
        #size-cells = <1>;
        interrupt-parent = <&intc>;

        sram1: memory@10000000 {
            compatible = "mmio-sram";
            reg = <0x10000000 DT_SIZE_K(512)>;
        };

        sram2: memory@10080000{
            compatible = "mmio-sram";
            reg = <0x10080000 DT_SIZE_K(768)>;
        };

/*
        share_memory0: memory@1013f000{
            compatible = "mmio-sram";
            reg = <0x1013f000 0x1000>;
        };
*/
        psram: memory@18000000 {
            compatible = "zephyr,memory-region", "mmio-sram";
            reg = <0x18000000 DT_SIZE_M(8)>;
            zephyr,memory-region = "PSRAM";
            status = "okay";
        };

        intc: interrupt-controller {
            compatible = "linkedsemi,riscv,e906-intc";
            #address-cells = <0>;
            #interrupt-cells = <2>;
            interrupt-controller;
        };

        cctl_sysc_sec_cpu: clock-controller@40022000 {
            compatible = "linkedsemi,ls-cctl";
            reg = <0x40022000 DT_SIZE_K(1)>;
            #clock-cells = <3>;
            status = "okay";
        };

        cctl_sysc_sec_per: clock-controller@400a7c00 {
            compatible = "linkedsemi,ls-cctl";
            reg = <0x400a7c00 DT_SIZE_K(1)>;
            #clock-cells = <3>;
            status = "okay";
        };

        cctl_sysc_sec_pmu: clock-controller@4002f000 {
            compatible = "linkedsemi,ls-cctl";
            reg = <0x4002f000 DT_SIZE_K(1)>;
            #clock-cells = <3>;
            status = "okay";
        };

        cctl_sysc_app_cpu: clock-controller@40062000 {
            compatible = "linkedsemi,ls-cctl";
            reg = <0x40062000 DT_SIZE_K(1)>;
            #clock-cells = <3>;
            status = "okay";
        };

        cctl_sysc_app_per: clock-controller@4008fc00 {
            compatible = "linkedsemi,ls-cctl";
            reg = <0x4008fc00 DT_SIZE_K(1)>;
            #clock-cells = <3>;
            status = "okay";
        };

        cctl_sysc_app_pmu: clock-controller@4006f000 {
            compatible = "linkedsemi,ls-cctl";
            reg = <0x4006f000 DT_SIZE_K(1)>;
            #clock-cells = <3>;
            status = "okay";
        };

        rctl_sysc_sec_cpu: reset-controller@40022000 {
            compatible = "linkedsemi,rctl";
            reg = <0x40022000 DT_SIZE_K(1)>;
            #reset-cells = <1>;
            status = "okay";
        };

        rctl_sysc_sec_per: reset-controller@400a7c00 {
            compatible = "linkedsemi,rctl";
            reg = <0x400a7c00 DT_SIZE_K(1)>;
            #reset-cells = <1>;
            status = "okay";
        };

        rctl_sysc_app_cpu: reset-controller@40062000 {
            compatible = "linkedsemi,rctl";
            reg = <0x40062000 DT_SIZE_K(1)>;
            #reset-cells = <1>;
            status = "okay";
        };

        rctl_sysc_app_per: reset-controller@4008fc00 {
            compatible = "linkedsemi,rctl";
            reg = <0x4008fc00 DT_SIZE_K(1)>;
            #reset-cells = <1>;
            status = "okay";
        };

        dmac1: dmac@40041000 {
            compatible = "linkedsemi,dma", "snps,designware-dma-2.20a";
            reg = <0x40041000 0x1000>;
            #dma-cells = <2>;
            interrupts = <DMAC1_IRQN 3>;
            clocks = <DMAC1_CLOCK>;
            resets = <DMAC1_RESET>;
            interrupt-parent = <&intc>;
            dma-channels = <8>;
            dma-buf-addr-alignment = <4>;
            status = "okay";
        };

        dmac2: dmac@40042000 {
            compatible = "linkedsemi,dma", "snps,designware-dma-2.20a";
            reg = <0x40042000 0x1000>;
            #dma-cells = <2>;
            interrupts = <DMAC2_IRQN 3>;
            clocks = <DMAC2_CLOCK>;
            resets = <DMAC2_RESET>;
            interrupt-parent = <&intc>;
            dma-channels = <8>;
            dma-buf-addr-alignment = <4>;
            status = "okay";
        };

        pinctrl: pin-controller@4006f080 {
            compatible = "linkedsemi,lsqsh-pinctrl";
            reg = <0x4006f080 0x200>;
            interrupts = <PMU_EXT_SEC_IRQN 3>, <PMU_EXT_APP_IRQN 3>;
            interrupt-names = "cpu1", "cpu2";
            #address-cells = <1>;
            #size-cells = <1>;

            gpioa: gpio@4006f180 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f180 0x20>, <0x4006f360 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiob: gpio@4006f1a0 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f1a0 0x20>, <0x4006f368 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpioc: gpio@4006f1c0 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f1c0 0x20>, <0x4006f370 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiod: gpio@4006f1e0 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f1e0 0x20>, <0x4006f378 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpioe: gpio@4006f200 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f200 0x20>, <0x4006f380 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiof: gpio@4006f220 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f220 0x20>, <0x4006f388 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiog: gpio@4006f240 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f240 0x20>, <0x4006f390 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpioh: gpio@4006f260 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f260 0x20>, <0x4006f398 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpioi: gpio@4006f280 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f280 0x20>, <0x4006f3a0 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpioj: gpio@4006f2a0 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f2a0 0x20>, <0x4006f3a8 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiok: gpio@4006f2c0 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f2c0 0x20>, <0x4006f3b0 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiom: gpio@4006f2e0 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f2e0 0x20>, <0x4006f3b8 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpion: gpio@4006f300 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f300 0x20>, <0x4006f3c0 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpioq: gpio@4006f320 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f320 0x20>, <0x4006f3c8 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiot: gpio@4006f340 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f340 0x20>, <0x4006f3d0 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };
        };

        pwm:pwm@40082000 {
            compatible = "linkedsemi,ls-pwm";
            reg = <0x40082000 0x100>;
            clocks = <PWM_CLOCK>;
            resets = <PWM_RESET>;
            clock-frequency = <PBUS4_CLOCK>;
            #pwm-cells = <3>;
            status = "disabled";
        };

        sgpiom1: sgpiom@40097000 {
            compatible = "linkedsemi,sgpiom";
            reg = <0x40097000 0x400>;
            interrupts = <151 3>;
            interrupts = <CALC_SM4_IRQN 3>;
            clocks = <SGPIO1_MST_CLOCK>;
            resets = <SGPIO1_MST_RESET>;
            ngpios = <256>;
            linkedsemi,bus-freq = <1000000>;
            status = "disabled";

            sgpiom_a_d: sgpiom_a_d {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <0>;
                status = "disabled";
            };

            sgpiom_e_h: sgpiom_e_h {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <32>;
                status = "disabled";
            };

            sgpiom_i_l: sgpiom_i_l {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <64>;
                status = "disabled";
            };

            sgpiom_m_p: sgpiom_m_p {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <96>;
                status = "disabled";
            };
        };

        sgpiom2: sgpiom@40097400 {
            compatible = "linkedsemi,sgpiom";
            reg = <0x40097400 0x400>;
            interrupts = <152 3>;
            clocks = <SGPIO2_MST_CLOCK>;
            resets = <SGPIO2_MST_RESET>;
            ngpios = <256>;
            linkedsemi,bus-freq = <1000000>;
            status = "disabled";

            sgpiom2_a_d: sgpiom2_a_d {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <0>;
                status = "disabled";
            };

            sgpiom2_e_h: sgpiom2_e_h {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <32>;
                status = "disabled";
            };

            sgpiom2_i_l: sgpiom2_i_l {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <64>;
                status = "disabled";
            };

            sgpiom2_m_p: sgpiom2_m_p {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <96>;
                status = "disabled";
            };
        };

        mtimer: machine-timer@e0004000 {
            compatible = "linkedsemi,machine-timer";
            reg = <0xe0004000 0x8000>;
            interrupts = <RV_TIME_IRQN 0>;
        };

        sha512:sha512@40005000 {
            compatible = "linkedsemi,sha512";
            reg = <0x40005000 0x400>;
            interrupts = <SHA512_IRQN 3>;
            clocks = <SHA512_CLOCK>;
            resets = <SHA512_RESET>;
            status = "disabled";
        };

        otbn:otbn@40010000 {
            compatible = "linkedsemi,otbn-crypto";
            reg = <0x40010000 0x400>;
            interrupts = <OBTN_IRQN 3>;
            clocks = <OTBN_CLOCK>;
            status = "disabled";
            sm2: otbn-sm2 {
                compatible = "linkedsemi,otbn-sm2";
                otbn-parent = <&otbn>;
                status = "disabled";
            };
            ecc_p256: otbn-p256 {
                compatible = "linkedsemi,otbn-ecc-p256";
                otbn-parent = <&otbn>;
                status = "disabled";
            };
            ecc_p384: otbn-p384 {
                compatible = "linkedsemi,otbn-ecc-p384";
                otbn-parent = <&otbn>;
                status = "disabled";
            };
        };

        sha256:sha256@40002800 {
            compatible = "linkedsemi,sha256";
            reg = <0x40002800 0x400>;
            interrupts = <CALC_SHA256_IRQN 3>;
            clocks = <CALC_SHA_CLOCK>;
            resets = <CALC_SHA_RESET>;
            status = "disabled";
        };

        trng0: dwtrng@40004000 {
            compatible = "linkedsemi,ls-dwtrng";
            reg = <0x40004000 0x400>;
            status = "disabled";
            clocks = <NIST_TRNG_CLOCK>;
            resets = <NIST_TRNG_RESET>;
            interrupts = <NIST_TRNG_IRQN 3>;
        };


        aes256: aes256@40029000 {
            compatible = "linkedsemi,aes256";
            reg = <0x40029000 0x400>;
            interrupts = <CALC_AES256_IRQN 3>;
            clocks = <CRYPT_CLOCK>;
            resets = <CRYPT_RESET>;
            status = "disabled";
        };

        cap:cap@40082400 {
            compatible = "linkedsemi,ls-cap";
            reg = <0x40082400 0x400>;
            status = "disabled";
            interrupts = <CAP_IRQN 3>;
            clocks = <CAP_CLOCK>;
            clock-frequency = <PBUS4_CLOCK>;
        };

        sm4:sm4@40029400 {
            compatible = "linkedsemi,sm4";
            reg = <0x40029400 0x400>;
            interrupts = <CALC_SM4_IRQN 3>;
            clocks = <CALC_SM4_CLOCK>;
            resets = <CALC_SM4_RESET>;
            status = "disabled";
        };

        espi1: espi@40045000 {
            compatible = "linkedsemi,ls-espi";
            reg = <0x40045000 0x1000>;
            interrupts = <ESPI1_IRQN 3>;
            clocks = <ESPI1_CLOCK>;
            resets = <ESPI1_RESET>;
            #address-cells = <1>;
            #size-cells = <1>;
            status = "disabled";

            vuart1: vuart1@40087800 {
                compatible = "linkedsemi,ls-host-vuart";
                reg = <0x40087800 0x400>;
                interrupts = <UART3_IRQN 3>;
                clocks = <UART3_CLOCK>;
                resets = <UART3_RESET>;
                port = <0x3f8>;
                up-irq = <0x4 0>;
                target = <&vuart_v0>;
                status = "disabled";
            };

            sio1: sio1 {
                compatible = "linkedsemi,ls-sio";
                port = <0x2e>;
                status = "disabled";
            };

            mmbi1: mmbi1 {
                compatible = "linkedsemi,ls-mmbi";
                host-addr = <0xf6810000>;
                size-order = <0>;
                status = "disabled";
            };

            vuart_v0: vuart@0 {
                compatible = "linkedsemi,vuart";
                status = "disabled";
                reg = <0x0 0x10>;
            };

        };
        
  
        sec_iwdg: watchdog@400a1800 {
          compatible = "linkedsemi,ls-watchdog";
          reg = <0x400a1800 0x400>;
          interrupts = <IWDT1_IRQN  4>;
          status = "disabled";
          clocks = <IWDT1_CLOCK>;
          resets = <IWDT1_RESET>;
          clock-frequency = <32768>;
        };
        app_iwdg: watchdog@40099000{
          compatible = "linkedsemi,ls-watchdog";
          reg = <0x40099000 0x400>;
          interrupts = <IWDT2_IRQN 4>;
          status = "disabled";
          clocks = <IWDT2_CLOCK>;
          resets = <IWDT2_RESET>;
          clock-frequency = <32768>;
        };
        pmu_iwdg: watchdog@4002f800{
          compatible = "linkedsemi,ls-watchdog";
          reg = <0x4002f800 0x400>;
          interrupts = <PMU_WDT_IRQN 4>;
          status = "disabled";
          clocks = <WDT_CLOCK>;
          clock-frequency = <32768>;
        };

        espi2: espi@40046000 {
            compatible = "linkedsemi,ls-espi";
            reg = <0x40046000 0x1000>;
            interrupts = <ESPI2_IRQN 3>;
            clocks = <ESPI2_CLOCK>;
            resets = <ESPI2_RESET>;
            status = "disabled";
        };

        lpc1: lpc@40047000 {
            compatible = "linkedsemi,ls-lpc";
            reg = <0x40047000 0x1000>;
            interrupts = <LPC1_IRQN 3>;
            clocks = <LPC1_CLOCK>;
            resets = <LPC1_RESET>;
            status = "disabled";
        };

        lpc2: lpc@40048000 {
            compatible = "linkedsemi,ls-lpc";
            reg = <0x40048000 0x1000>;
            interrupts = <LPC2_IRQN 3>;
            clocks = <LPC2_CLOCK>;
            resets = <LPC2_RESET>;
            status = "disabled";
        };

        ipmi_kcs: ipmi_kcs {
            compatible = "linkedsemi,ls-ipmi-kcs";
            status = "disabled";
        };

        i2c1: i2c@400a0000 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x400a0000 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C1_IRQN 3>;
            clocks = <I2C1_CLOCK>;
            resets = <I2C1_RESET>;
            clock-frequency = <PBUS4_CLOCK>;
            status = "disabled";
        };

        i2c2: i2c@40083400 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40083400 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C2_IRQN 3>;
            clocks = <I2C2_CLOCK>;
            resets = <I2C2_RESET>;
            clock-frequency = <PBUS4_CLOCK>;
            status = "disabled";
        };

        i2c3: i2c@40083800 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40083800 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C3_IRQN 3>;
            clocks = <I2C3_CLOCK>;
            resets = <I2C3_RESET>;
            clock-frequency = <PBUS4_CLOCK>;
            status = "disabled";
        };

        i2c4: i2c@40083c00 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40083c00 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C4_IRQN 3>;
            clocks = <I2C4_CLOCK>;
            resets = <I2C4_RESET>;
            clock-frequency = <PBUS4_CLOCK>;
            status = "disabled";
        };

        i2c5: i2c@40084000 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40084000 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C5_IRQN 3>;
            clocks = <I2C5_CLOCK>;
            resets = <I2C5_RESET>;
            clock-frequency = <PBUS4_CLOCK>;
            status = "disabled";
        };

        i2c6: i2c@40084400 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40084400 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C6_IRQN 3>;
            clocks = <I2C6_CLOCK>;
            resets = <I2C6_RESET>;
            clock-frequency = <PBUS4_CLOCK>;
            status = "disabled";
        };

        i2c7: i2c@40084800 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40084800 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C7_IRQN 3>;
            clocks = <I2C7_CLOCK>;
            resets = <I2C7_RESET>;
            clock-frequency = <PBUS4_CLOCK>;
            status = "disabled";
        };

        i2c8: i2c@40084C00 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40084C00 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C8_IRQN 3>;
            clocks = <I2C8_CLOCK>;
            resets = <I2C8_RESET>;
            clock-frequency = <PBUS4_CLOCK>;
            status = "disabled";
        };

        i2c9: i2c@40085000 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40085000 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C9_IRQN 3>;
            clocks = <I2C9_CLOCK>;
            resets = <I2C9_RESET>;
            clock-frequency = <PBUS4_CLOCK>;
            status = "disabled";
        };

        i2c10: i2c@40085400 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40085400 0x400>;
            #address-cells = <1>;
