        };

        i2c14: i2c@40086400 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40086400 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C14_IRQN 3>;
