        uart1: uart@400a1000 {
            compatible = "linkedsemi,ls-uart";
            reg = <0x400a1000 0x400>;
            interrupts = <UART1_IRQN 3> ;
            status = "disabled";
        };
        uart2: uart@40087400 {
            compatible = "linkedsemi,ls-uart";
            reg = <0x40087400 0x400>;
            interrupts = <UART2_IRQN 3> ;
            status = "disabled";
        };

        uart3: uart@40087800 {
            compatible = "ns16550";
            reg = <0x40087800 0x400>;
            clock-frequency = <50000000>;
            interrupts = <UART3_IRQN 3> ;
            reg-shift = <2>;
            status = "disabled";
        };

        uart4: uart@40087c00 {
            compatible = "ns16550";
            reg = <0x40087c00 0x400>;
            clock-frequency = <50000000>;
            interrupts = <UART4_IRQN 3> ;
            reg-shift = <2>;
            status = "disabled";
        };

        uart5: uart@40088000 {
            compatible = "ns16550";
            reg = <0x40088000 0x400>;
            clock-frequency = <50000000>;
            interrupts = <UART5_IRQN 3> ;
            reg-shift = <2>;
            status = "disabled";
        };

        uart6: uart@40088400 {
