        usb1: usb@40043000 {
            compatible = "linkedsemi,ls-fs-usb";
            reg = <0x40043000 0x1000>;
            clocks = <USB1_CLOCK>;
            resets = <USB1_RESET>;
            interrupts = <USB1_IRQN 3>;
            num-bidir-endpoints = <8>;
            maximum-speed = "full-speed";
            ram-size = <64>;
            status = "disabled";
        };

        adc1: adc@4008b000 {
            compatible = "linkedsemi,ls-adc";
            reg = <0x4008b000 0x400>;
            interrupts = <ADC1_IRQN 3>;
            clocks = <ADC1_CLOCK>;
            clock-source = <CLK_SRC_PBUS4>;
            resets = <ADC1_RESET>;
            status = "disabled";
        };

        adc2: adc@4008b400 {
            compatible = "linkedsemi,ls-adc";
            reg = <0x4008b400 0x400>;
            interrupts = <ADC2_IRQN 3>;
            clocks = <ADC2_CLOCK>;
            clock-source = <CLK_SRC_PBUS4>;
            resets = <ADC2_RESET>;
            status = "disabled";
        };
    };

    power-states {
        idle: idle{
            compatible = "zephyr,power-state";
            power-state-name = "runtime-idle";
        };

        lp0: lp0 {
            compatible = "zephyr,power-state";
            power-state-name = "standby";
        };
    };
};

#include "lsqsh_pinctrl_fixed_pinmap.dtsi"
