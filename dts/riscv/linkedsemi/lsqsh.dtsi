#include <zephyr/dt-bindings/pinctrl/lsqsh-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <mem.h>

#include <zephyr/dt-bindings/memory-attr/memory-attr.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-riscv.h>
#include "../../../../modules/hal/linkedsemi/soc/rv32/qsh/reg_base_addr.h"
#include "../../../../modules/hal/linkedsemi/soc/rv32/qsh/qsh.h"

/ {
    #address-cells = <1>;
    #size-cells = <1>;

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        cpu1: cpu@1 {
            device_type = "cpu";
            compatible = "linkedsemi,riscv";
            riscv,isa = "rv32imafcxp";
            reg = <1>;
        };
        cpu2: cpu@2 {
            device_type = "cpu";
            compatible = "linkedsemi,riscv";
            riscv,isa = "rv32imafcxp";
            reg = <2>;
            status = "disabled";
        };
    };

    sram1: memory@10000000 {
        compatible = "mmio-sram";
        reg = <0x10000000 DT_SIZE_K(512)>;  
    };

    sram2: memory@10080000{
        compatible = "mmio-sram";
        reg = <0x10080000 DT_SIZE_K(768)>;
    };

/*
    share_memory0: memory@1013f000{
        compatible = "mmio-sram";
        reg = <0x1013f000 0x1000>;
    };
*/

    soc {
        compatible = "simpe-bus";
        #address-cells = <1>;
        #size-cells = <1>;
        interrupt-parent = <&intc>;

        intc: interrupt-controller {
            compatible = "linkedsemi,riscv,e906-intc";
            #address-cells = <0>;
            #interrupt-cells = <2>;
            interrupt-controller;
        };

        dmac1: dmac@40041000 {
            compatible = "snps,designware-dma";
            reg = <0x40041000 0x1000>;
            #dma-cells = <1>;
            interrupts = <DMAC1_IRQN 3>;
            interrupt-parent = <&intc>;
            dma-channels = <8>;
            dma-buf-addr-alignment = <4>;
            status = "disabled";
        };

        dmac2: dmac@40042000 {
            compatible = "snps,designware-dma";
            reg = <0x40042000 0x1000>;
            #dma-cells = <1>;
            interrupts = <DMAC2_IRQN 3>;
            interrupt-parent = <&intc>;
            dma-channels = <8>;
            dma-buf-addr-alignment = <4>;
            status = "disabled";
        };

        qspi1: qspi@40000000 {
            compatible = "linkedsemi,ls-flash-controller";
            reg = <0x40000000 0x1000>;
            #address-cells = <1>;
            #size-cells = <1>;
            interrupts = <QSPI1_IRQN 3>;
            status = "disabled";

            flash1: flash@8000000 {
                compatible = "soc-nv-flash";
                reg = <0x8000000 0x400000>;
                erase-block-size = <4096>;
                write-block-size = <4>;
            };
        };
        
        per_cctl: clock-controller@4008d000 {
            compatible = "linkedsemi,ls-cctl";
            #clock-cells = <3>;
            reg = <0x4008d000 0x400>;
            status = "okay";
        };

        pinctrl: pin-controller@4002f080 {
            compatible = "linkedsemi,lsqsh-pinctrl";
            reg = <0x4002f080 0x200>;
            interrupts = <PMU_EXT_SEC_IRQN 3>, <PMU_EXT_APP_IRQN 3>;
            interrupt-names = "cpu1", "cpu2";
            #address-cells = <1>;
            #size-cells = <1>;

            gpioa: gpio@4002f180 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4002f180 0x20>, <0x4002f360 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiob: gpio@4006f1a0 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f1a0 0x20>, <0x4006f368 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpioc: gpio@4002f1c0 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4002f1c0 0x20>, <0x4002f370 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiod: gpio@4006f1e0 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f1e0 0x20>, <0x4006f378 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpioe: gpio@4002f200 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4002f200 0x20>, <0x4002f380 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiof: gpio@4006f220 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f220 0x20>, <0x4006f388 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiog: gpio@4006f240 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f240 0x20>, <0x4006f390 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpioh: gpio@4006f260 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f260 0x20>, <0x4006f398 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpioi: gpio@4002f280 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4002f280 0x20>, <0x4002f3a0 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpioj: gpio@4006f2a0 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f2a0 0x20>, <0x4006f3a8 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiok: gpio@4002f2c0 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4002f2c0 0x20>, <0x4002f3b0 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiom: gpio@4006f2e0 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f2e0 0x20>, <0x4006f3b8 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpion: gpio@4006f300 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f300 0x20>, <0x4006f3c0 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpioq: gpio@4006f320 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f320 0x20>, <0x4006f3c8 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };

            gpiot: gpio@4006f340 {
                compatible = "linkedsemi,lsqsh-gpio";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x4006f340 0x20>, <0x4006f3d0 0x8>;
                reg-names = "io_cfg", "io_val";
                status = "disabled";
            };
        };

        sgpiom: sgpiom@40097000 {
            compatible = "linkedsemi,sgpiom";
            reg = <0x40097000 0x400>;
            interrupts = <151 3>;
            ngpios = <256>;
            linkedsemi,bus-freq = <1000000>;
            status = "disabled";

            sgpiom_a_d: sgpiom_a_d {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <0>;
                status = "disabled";
            };

            sgpiom_e_h: sgpiom_e_h {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <32>;
                status = "disabled";
            };

            sgpiom_i_l: sgpiom_i_l {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <64>;
                status = "disabled";
            };

            sgpiom_m_p: sgpiom_m_p {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <96>;
                status = "disabled";
            };
        };

        sgpiom2: sgpiom@40097400 {
            compatible = "linkedsemi,sgpiom";
            reg = <0x40097400 0x400>;
            interrupts = <152 3>;
            ngpios = <256>;
            linkedsemi,bus-freq = <1000000>;
            status = "disabled";

            sgpiom2_a_d: sgpiom2_a_d {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <0>;
                status = "disabled";
            };

            sgpiom2_e_h: sgpiom2_e_h {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <32>;
                status = "disabled";
            };

            sgpiom2_i_l: sgpiom2_i_l {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <64>;
                status = "disabled";
            };

            sgpiom2_m_p: sgpiom2_m_p {
                #gpio-cells = <2>;
                gpio-controller;
                ngpios = <32>;
                #address-cells = <0>;
                interrupt-controller;
                #interrupt-cells = <2>;
                pin-offset = <96>;
                status = "disabled";
            };
        };

        mtimer: machine-timer@e0004000 {
            compatible = "linkedsemi,machine-timer";
            reg = <0xe0004000 0x8000>;
            interrupts = <RV_TIME_IRQN 0>;
        };

        crypto: crypto@40028400 {
            compatible = "linkedsemi,crypto";
            reg = <0x40028400 0x400>,
                  <0x40028800 0x400>,
                  <0x40028C00 0x400>,
                  <0x40029000 0x400>;
            reg-names = "calc_sha", "calc_crc", "calc", "crypt";
            interrupts = <CALC_AES256_IRQN 3>,
                         <CALC_SHA256_IRQN 3>,
                         <OBTN_IRQN 3>,
                         <OTBN_SYSC_IRQN 3>;
            interrupt-names = "crypto", "sha", "otbn", "sysc_otbn";
            status = "disabled";
        };

        sm4:sm4@40029400 {
            compatible = "linkedsemi,sm4";
            reg = <0x40029400 0x400>;
            interrupts = <CALC_SM4_IRQN 3>;
            status = "disabled";
            clocks = <&per_cctl 0 0 0>; // TODO
        };

        espi1: espi@40045000 {
            compatible = "linkedsemi,ls-espi";
            reg = <0x40045000 0x1000>;
            interrupts = <ESPI1_IRQN 3>;
            status = "disabled";
        };

        espi2: espi@40046000 {
            compatible = "linkedsemi,ls-espi";
            reg = <0x40046000 0x1000>;
            interrupts = <ESPI2_IRQN 3>;
            status = "disabled";
        };

        lpc1: lpc@40047000 {
            compatible = "linkedsemi,ls-lpc";
            reg = <0x40047000 0x1000>;
            interrupts = <LPC1_IRQN 3>;
            status = "disabled";
        };

        lpc2: lpc@40048000 {
            compatible = "linkedsemi,ls-lpc";
            reg = <0x40048000 0x1000>;
            interrupts = <LPC2_IRQN 3>;
            status = "disabled";
        };

        ipmi_kcs: ipmi_kcs {
            compatible = "linkedsemi,ls-ipmi-kcs";
            status = "disabled";
        };

        i2c1: i2c@400a0000 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x400a0000 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C1_IRQN 3>;
            status = "disabled";
        };

        i2c2: i2c@40083400 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40083400 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C2_IRQN 3>;
            status = "disabled";
        };

        i2c3: i2c@40083800 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40083800 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C3_IRQN 3>;
            status = "disabled";
        };

        i2c4: i2c@40083c00 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40083c00 0x400>;
            #address-cells = <1>;
            #size-cells = <0>;
            interrupts = <I2C4_IRQN 3>;
            status = "disabled";
        };

        i2c5: i2c@40084000 {
            compatible = "linkedsemi,ls-i2c";
            reg = <0x40084000 0x400>;
