        uart11: uart@40089800 {
            compatible = "ns16550";
            reg = <0x40089800 0x400>;
            clock-frequency = <50000000>;
            interrupts = <UART11_IRQN 3> ;
            reg-shift = <2>;
            status = "disabled";
        };

        uart12: uart@40089c00 {
            compatible = "ns16550";
            reg = <0x40089c00 0x400>;
            clock-frequency = <50000000>;
            interrupts = <UART12_IRQN 3> ;
            reg-shift = <2>;
            status = "disabled";
        };

        mac1: ethernet@40064000 {
            compatible = "linkedsemi,ethernet", "snps,designware-ethernet";
            reg = <0x40064000 0x2000>;
            interrupts = <ETH1_IRQN 3>;
            status = "disabled";

            mdio1: mdio {
                compatible = "snps,dwmac-mdio";
                #address-cells = <1>;
                #size-cells = <0>;
                status = "disabled";
            };
        };

        mac2: ethernet@40066000 {
            compatible = "linkedsemi,ethernet", "snps,designware-ethernet";
            reg = <0x40066000 0x2000>;
            interrupts = <ETH2_IRQN 3>;
            status = "disabled";

            mdio2: mdio {
                compatible = "snps,dwmac-mdio";
                #address-cells = <1>;
                #size-cells = <0>;
                status = "disabled";
            };
        };

        spi1: spi@4008a000 {
            compatible = "linkedsemi,ls-spi";
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <0x4008a000 0x400>;
            clock-frequency = <50000000>;
            interrupts = <SPI1_IRQN 3>;
            status = "disabled";
        };

        spi2: spi@4008a400 {
            compatible = "linkedsemi,ls-spi";
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <0x4008a400 0x400>;
            clock-frequency = <50000000>;
            interrupts = <SPI2_IRQN 3>;
            status = "disabled";
        };

        spi3: spi@4006e000 {
            compatible = "snps,designware-spi";
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <0x4006e000 0x400>;
            clock-frequency = <50000000>;
            interrupts = <SPI3_IRQN 3>;
            fifo-depth = <4>;
            max-xfer-size = <32>;
            status = "disabled";
        };

        spi4: spi@4006e400 {
            compatible = "snps,designware-spi";
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <0x4006e400 0x400>;
            interrupts = <SPI4_IRQN 3>;
            fifo-depth = <4>;
            max-xfer-size = <32>;
            status = "disabled";
        };

        peci1: peci@4008d800 {
            compatible = "linkedsemi,ls-peci";
            reg = <0x4008d800 0x400>;
            #address-cells= <1>;
            #size-cells = <0>;
            interrupts = <PECI1_IRQN 3>;
            status = "disabled";
        };

        peci2: peci@4008dc00 {
            compatible = "linkedsemi,ls-peci";
            reg = <0x4008dc00 0x400>;
            #address-cells= <1>;
            #size-cells = <0>;
            interrupts = <PECI2_IRQN 3>;
            status = "disabled";
        };

        sdhci1: sdhci@40049000 {
            compatible = "linkedsemi,sdhci";
            reg = <0x40049000 0x1000>;
            interrupts = <EMMC1_IRQN 3>;
            max-bus-freq = <5000000>;
            min-bus-freq = <200000>;
            status = "disabled";
        };

        sdhci2: sdhci@4004a000 {
            compatible = "linkedsemi,sdhci";
            reg = <0x4004a000 0x1000>;
            interrupts = <EMMC2_IRQN 3>;
            max-bus-freq = <5000000>;
            min-bus-freq = <200000>;
            status = "disabled";
        };

        jtag1: jtag@40092000 {
            compatible = "linkedsemi,ls-jtag";
            reg = <0x40092000 0x400>;
            interrupts = <MJTAG1_IRQN 3>;
            status = "disabled";
        };

        jtag2: jtag@40092400 {
            compatible = "linkedsemi,ls-jtag";
            reg = <0x40092400 0x400>;
            interrupts = <MJTAG2_IRQN 3>;
            status = "disabled";
        };

        jtag3: jtag@40092800 {
            compatible = "linkedsemi,ls-jtag";
            reg = <0x40092800 0x400>;
            interrupts = <MJTAG3_IRQN 3>;
            status = "disabled";
        };

        i3c9: i3c@40095000 {
            compatible = "linkedsemi,i3c";
            #address-cells = <3>;
            #size-cells = <0>;
            reg = <0x40095000 0x2000>;
            interrupts = <120 3>;
            status = "disabled";
            i3c-scl-hz = <1000000>;
        };

        i3c10: i3c@40095400 {
            compatible = "linkedsemi,i3c";
            #address-cells = <3>;
            #size-cells = <0>;
            reg = <0x40095400 0x2000>;
            interrupts = <121 3>;
            status = "disabled";
            i3c-scl-hz = <1000000>;
        };
    };

    power-states {
        idle: idle{
            compatible = "zephyr,power-state";
            power-state-name = "runtime-idle";
        };

        lp0: lp0 {
            compatible = "zephyr,power-state";
            power-state-name = "standby";
        };
    };
};

#include "lsqsh_pinctrl_fixed_pinmap.dtsi"
