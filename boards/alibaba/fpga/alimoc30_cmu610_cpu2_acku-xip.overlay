#include "alicmu_pinctrl_acku.dtsi"

/ {
    chosen {
        zephyr,sram = &sram2;
        zephyr,console = &uart4;
        zephyr,shell-uart = &uart4;
        zephyr,flash = &flash_xip;
        zephyr,flash-controller = &qspi1;
        share,flash = &flash1;
    };

    fstab {
        compatible = "zephyr,fstab";
        lfs1: lfs1{
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/lfs";
            partition = <&storage_partition>;
            automount;
            no-format;
            read-size = <16>;
            prog-size = <16>;
            cache-size = <4096>;
            lookahead-size = <256>;
            block-cycles = <512>;
        };
    };
};

&uart1 {
    current-speed = <115200>;
    status = "disabled";
};

&uart2 {
    current-speed = <115200>;
    status = "disabled";
};

&uart3 {
    current-speed = <115200>;
    status = "disabled";
};

&uart4 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart4_tx_pd11 &uart4_rx_pd12>;
    pinctrl-names = "default";
};

&uart5 {
    status = "disabled";
};

&i2c1 {
    status = "okay";
    label = "i2c-1";
};
&i2c2 {
    status = "okay";
    label = "i2c-2";
};

&smbus1 {
    status = "okay";
};

&smbus2 {
    status = "okay";
};

&espi1 {
    espi1_kcs_ca2: espi1_kcs_ca2 {
        compatible = "linkedsemi,ls-kcs";
        port = <0xca2 0xca3>;
        status = "okay";
    };
    status = "okay";
};
&ipmi_kcs {
    kcs_chan = <&espi1_kcs_ca2>;
    status = "okay";
    label = "ipmi-kcs";
};

&qspi1 {
    compatible = "linkedsemi,mbox-cpu2-flash-controller";
    mbox = <&mbox_consumer3>;
    status = "okay";

    flash1: flash@8000000 {
        compatible = "soc-nv-flash";
        reg = <0x8000000 DT_SIZE_M(16)>;
        erase-block-size = <4096>;
        write-block-size = <4>;

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            reserved_partition: partition@0 {
                label = "reserved";
                reg = <0x0 DT_SIZE_M(8)>;
            };
            boot_partition: partition@800000 {
                label = "info-sbl";
                reg = <0x800000 DT_SIZE_M(2)>;
            };
            app_partition: partition@a00000 {
                label = "app";
                reg = <0xa00000 DT_SIZE_M(2)>;
            };
            storage_partition: partition@f00000 {
                label = "storage";
                reg = <0xf00000 DT_SIZE_M(1)>;
            };
        };
    };

    flash_xip: flash@8080000 {
        compatible = "soc-nv-flash";
        reg = <0x8080000 DT_SIZE_M(6)>;
        erase-block-size = <4096>;
        write-block-size = <4>;
    };
};

&psram {
    status = "okay";
};
