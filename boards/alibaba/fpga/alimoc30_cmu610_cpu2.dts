    /*A0-A7*/	"","","","","","","","",
    /*B0-B7*/	"","","","","","","","";
};

&gpioq {
    label = "gpiochip13";
    ngpios = <16>;
    status = "okay";
    gpio-line-names =
    /*A0-A7*/	"","","","","","","","",
    /*B0-B7*/	"","","","","","","","";
};

&gpiot {
    label = "gpiochip14";
    ngpios = <16>;
    status = "okay";
    gpio-line-names =
    /*A0-A7*/	"","","","","","","","",
    /*B0-B7*/	"","","","","","","","";
};

&spi3 {
    status = "okay";
    flash3_0: flash3@0 {
        compatible = "jedec,spi-nor";
        reg = <0>;
        spi-max-frequency = <DT_FREQ_M(10)>;
        re-init-support;
    };
};

zephyr_udc0: &usb2 {
    status = "okay";
};

zephyr_udc1: &usb1 {
    status = "disabled";
};

&eth1 {
    status = "okay";
};

&mdio1 {
    status = "okay";
};

&sdhci1 {
    status = "okay";

    mmc_disk1: disk {
        compatible = "zephyr,mmc-disk";
        disk-name = "mnt";
        bus-width = <1>;
        status = "okay";
    };
};

&peci1 {
    status = "okay";
};

#if !ENABLE_ESPI_VUART_ON_CPU1
&vuart1 {
    interrupts = <UART3_IRQN 3>;
    pinctrl-0 = <&uart3_txd_pb01 &uart3_rxd_pb03>;
    pinctrl-names = "default";
    label = "vttyS1";
    status = "okay";
};

&espi1 {
    espi1_kcs_ca2: espi1_kcs_ca2 {
        compatible = "linkedsemi,ls-kcs";
        port = <0xca2 0xca3>;
        status = "okay";
    };
    status = "okay";
};

&ipmi_kcs {
    kcs_chan = <&espi1_kcs_ca2>;
    status = "okay";
    label = "ipmi-kcs";
};

&sio1 {
    status = "okay";
};

&mmbi1 {
    status = "okay";
};
#endif
