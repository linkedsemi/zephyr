/dts-v1/;
#include <riscv/linkedsemi/lsqsh.dtsi>
#include "alicmu_pinctrl_acku.dtsi"

#define BTN_GPIO_FLAGS (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)

/ {
    model = "linkedsemi LSQSH_EVB";
    compatible = "linkedsemi,lsqsh_app_evb";

    chosen {
        zephyr,sram = &sram2;
        zephyr,console = &uart4;
        zephyr,shell-uart = &uart4;
        zephyr,flash-controller = &qspi1;
        zephyr,internal-flash = &flash1;
    };

    aliases {
        peci0 = &peci1;
        sdhc0 = &sdhci1;
        watchdog0=&app_iwdg;
    };

    fstab {
        compatible = "zephyr,fstab";
        ro_lfs_a: ro_lfs_a{
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/ro";
            partition = <&a_rofs_partition>;
            // automount;
            no-format;
            read-only;
            read-size = <32>;
            prog-size = <32>;
            cache-size = <64>;
            lookahead-size = <256>;
            block-cycles = <512>;
        };
        ro_lfs_b: ro_lfs_b{
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/ro";
            partition = <&b_rofs_partition>;
            // automount;
            no-format;
            read-only;
            read-size = <32>;
            prog-size = <32>;
            cache-size = <64>;
            lookahead-size = <256>;
            block-cycles = <512>;
        };
        rw_lfs: rw_lfs{
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/rw";
            partition = <&rwfs_partition>;
            // automount;
            // no-format;
            read-size = <32>;
            prog-size = <32>;
            cache-size = <64>;
            lookahead-size = <256>;
            block-cycles = <512>;
        };
    };

    soc {
        compatible = "simpe-bus";
        #address-cells = <1>;
        #size-cells = <1>;
        interrupt-parent = <&intc>;

        share_memory: share-memory@1013e000 {
            compatible = "zephyr,memory-region", "mmio-sram";
            reg = <0x1013e000 DT_SIZE_K(4)>;
            zephyr,memory-region = "SHMEM";
        };

        mbox: mbox@1013f000 {
            compatible = "linkedsemi,mbox";
            reg = <0x1013f000 DT_SIZE_K(4)>;
            interrupts = <SYSC_APP_CPU_IRQN 3>;
            fifo-deepth = <8>;
            fifo-width = <64>;
            #mbox-cells = <1>;
        };

        qspi1: flash-client@40000000 {
            compatible = "linkedsemi,ls-flash-delegation-client";
            reg = <0x40000000 0x400>;
            #address-cells = <1>;
            #size-cells = <1>;
            interrupts = <3 3>;
            mbox = <&mbox_consumer_qspi1>;

            flash1: flash@8000000 {
                compatible = "soc-nv-flash";
                reg = <0x8000000 DT_SIZE_M(32)>;
                erase-block-size = <4096>;
                write-block-size = <4>;
            };
        };
    };

    mbox_consumer1: mbox-consumer1 {
        compatible = "vnd,mbox-consumer";
        mboxes = <&mbox 0>, <&mbox 1>;
        mbox-names = "tx", "rx";
    };

    mbox_consumer2: mbox-consumer2 {
        compatible = "vnd,mbox-consumer";
        mboxes = <&mbox 2>, <&mbox 3>;
        mbox-names = "tx", "rx";
    };

    /* func call */
    mbox_consumer_qspi1: mbox-consumer3 {
        compatible = "vnd,mbox-consumer";
        mboxes = <&mbox 4>, <&mbox 5>;
        mbox-names = "tx", "rx";
    };

	cdc_ncm_eth0: cdc_ncm_eth0 {
		compatible = "zephyr,cdc-ncm-ethernet";
		remote-mac-address = "00005E005301";
	};
};

&cpu1 {
    status = "disabled";
};

&cpu2 {
    status = "okay";
};

&i2c2 {
    status = "okay";
    label = "i2c-2";
    eeprom: eeprom@50 {
        compatible = "atmel,at24";
        reg = <0x50>;
        status = "okay";
        size = <4096>;
        pagesize = <32>;
        address-width = <16>;
        timeout = <5>;
    };
};

&i2c5 {
    status = "okay";
    label = "i2c-5";
};

&i2c8 {
    status = "okay";
    label = "i2c-8";
};

&smbus2 {
    status = "okay";
};

&smbus5 {
    status = "okay";
};

&smbus8 {
    status = "okay";
};

&sram1 {
    status = "disabled";
};

&sram2 {
    reg = <0x10060000 DT_SIZE_K(888)>;
};

&uart1 {
    current-speed = <115200>;
    status = "disabled";
};

&uart2 {
    current-speed = <115200>;
    status = "disabled";
};

&uart3 {
    /delete-property/ interrupts;
    pinctrl-0 = <&uart3_txd_pb01 &uart3_rxd_pb03>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "disabled";
};

&uart4 {
    current-speed = <115200>;
    label = "ttyS0";
    status = "okay";
};

&uart5 {
    current-speed = <115200>;
    status = "disabled";
};

&app_iwdg {
    status = "okay";
};

&psram {
    status = "okay";
};

&gpioa {
    label = "gpiochip0";
    ngpios = <16>;
    status = "okay";
    gpio-line-names =
    /*A0-A7*/	"","","","","","","","",
    /*B0-B7*/	"","","","BMC_READY_OUT_N","","","","";
};

&gpiob {
    label = "gpiochip1";
    ngpios = <16>;
    status = "okay";
    gpio-line-names =
    /*A0-A7*/	"","","","","","","","",
    /*B0-B7*/	"","","","","","","","";
};

