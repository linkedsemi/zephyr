#include "alicmu_pinctrl_acku.dtsi"

/ {
    chosen {
        zephyr,sram = &sram1;
        zephyr,console = &uart4;
        zephyr,shell-uart = &uart4;
        zephyr,flash = &flash_xip;
        zephyr,flash-controller = &qspi1;
        share,flash = &flash0;
    };

	msc_disk0 {
		status="okay";
		compatible = "zephyr,flash-disk";
		partition = <&storage_partition>;
		disk-name = "SD2";
		/* cache-size == page erase size */
		cache-size = <4096>;
	};
};

&uart1 {
    current-speed = <115200>;
    status = "disabled";
};

&uart2 {
    current-speed = <115200>;
    status = "disabled";
};

&uart3 {
    current-speed = <115200>;
    status = "disabled";
};

&uart4 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart4_tx_pd11 &uart4_rx_pd12>;
    pinctrl-names = "default";
};

&uart5 {
    status = "disabled";
};

&qspi1 {
    compatible = "linkedsemi,mbox-cpu1-flash-controller";
    mbox = <&mbox_consumer2>;
    status = "okay";

    flash0: flash@8000000 {
        compatible = "soc-nv-flash";
        reg = <0x8000000 DT_SIZE_M(16)>;
        erase-block-size = <4096>;
        write-block-size = <4>;

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            reserved_partition: partition@0 {
                label = "reserved";
                reg = <0x0 DT_SIZE_M(8)>;
            };
            boot_partition: partition@800000 {
                label = "info-sbl";
                reg = <0x800000 DT_SIZE_M(2)>;
            };
            app_partition: partition@a00000 {
                label = "app";
                reg = <0xa00000 DT_SIZE_M(2)>;
            };
            storage_partition: partition@c00000 {
                label = "storage";
                reg = <0xc00000 DT_SIZE_M(4)>;
            };
        };
    };

    flash_xip: flash@8800000 {
        compatible = "soc-nv-flash";
        reg = <0x8800000 DT_SIZE_M(8)>;
        erase-block-size = <4096>;
        write-block-size = <4>;
    };
};
