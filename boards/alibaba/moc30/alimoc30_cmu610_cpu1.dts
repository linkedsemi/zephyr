&sdhci1 {
    max-bus-freq = <DT_FREQ_M(52)>;
    status = "okay";

    mmc_disk1: disk {
        compatible = "zephyr,mmc-disk";
        disk-name = "mnt";
        bus-width = <8>;
        status = "okay";
    };
};

// tst_dma0: &dma0 {
//     status = "okay";
// };

&lpc1 {
    status = "disabled";

    lpc_kcs_ca2: lpc_kcs_ca2 {
        compatible = "linkedsemi,ls-kcs";
        port = <0xca2 0xca3>;
        status = "disabled";
    };
};

#if ENABLE_ESPI_VUART_ON_CPU1
&vuart1 {
    interrupts = <UART3_IRQN 3>;
    pinctrl-0 = <&uart3_tx_pb01 &uart3_rx_pb03>;
    pinctrl-names = "default";
    status = "okay";
};

&espi1 {
    espi1_kcs_ca2: espi1_kcs_ca2 {
        compatible = "linkedsemi,ls-kcs";
        port = <0xca2 0xca3>;
        status = "okay";
    };
    status = "okay";
};

&ipmi_kcs {
    kcs_chan = <&espi1_kcs_ca2>;
    status = "okay";
    label = "ipmi-kcs";
};

&sio1 {
    status = "okay";
};

&mmbi1 {
    status = "okay";
};
#endif