/dts-v1/;
#include <riscv/linkedsemi/ls101x.dtsi>
#include "ls101x_evb-pinctrl.dtsi"
#include <zephyr/dt-bindings/pinctrl/ls101x-pinctrl.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/sensor/linkedsemi-cap.h>

#define BTN_GPIO_FLAGS (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)

/ {
	model = "linkedsemi LS101X_EVB";
	compatible = "linkedsemi,ls101x_evb";

	chosen {
		zephyr,flash = &flash0;
		zephyr,sram = &sram0;
		zephyr,shell-uart = &uart3;
		zephyr,console = &uart3;
	};

    aliases {
        testi2c1 = &i2c1;
        testi2c2 = &i2c2;
        testeeprom1 = &eeprom1;
        testeeprom2 = &eeprom2;
		led0 = &led0;
		sw0 = &btn0;
		peci-0 = &peci0;
		pwm-led0 = &pwm_led0;
    rtc0 = &rtc0;	
    watchdog0 = &iwdgt;
	};

	leds{
		compatible = "gpio-leds";
		led0: led_0{
			gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
			label = "Red LED";
		};
	};

	pwmleds {
		compatible = "pwm-leds";
		pwm_led0: pwm_led_0 {
			pwms = <&pwm 7 200 0>;
		};
	};

	keys {
		compatible = "gpio-keys";
		btn0: btn_0{
			gpios = <&gpiob 7 BTN_GPIO_FLAGS>;
			label = "Push button 1";
		};
	};

	ipmi {
		compatible = "linkedsemi,ls-ipmi-kcs";
		kcs_chan = <&e8042>;
	};
	hwmon0 {
		compatible = "linkedsemi,hwmon";
		class = <0>;
		hwmon-ins = <&cap 0>;//,<&pwm 1>;
	};
};

zephyr_udc0: &usb {
	pinctrl-0 = <&usb_dp_pd0 &usb_dm_pd1>;
	pinctrl-names = "default";
	status = "okay";
};

&flash0 {

    /*
	* Flash base address is 0x8000000,
    * the following parts are all offset addresses.
	*/

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "info-sbl";
			reg = <0x00000000 0x00001800>;
		};
	
        app_partition: partition@1800 {
			label = "app";
			reg = <0x00001800 0x0007c800>;
		};

		/*
		 * The flash starting at 0x807d000 and ending at
		 * 0x807FFFF is reserved for use by the application.
		 */

		/*
		 * Storage partition will be used by FCB/LittleFS/NVS
		 * if enabled.
		 */
		storage_partition: partition@7d000 {
			label = "storage";
			reg = <0x0007d000 0x00003000>;
		};
	};
};

&cpu0 {
	clock-frequency = <144000000>;
	cpu-power-states = <&idle &lp0>;
};

&rtc0{
    status = "okay";

 };

&uart1 {
	status = "disabled";
	pinctrl-0 = <&uart1_tx_pb00 &uart1_rx_pb01>;
	pinctrl-names = "default";
	current-speed = <921600>;
};
&uart2 {
	status = "disabled";
	pinctrl-0 = <&uart2_tx_pb02 &uart2_rx_pb03 >;
	pinctrl-names = "default";
	current-speed = <921600>;
};
&uart3 {
	status = "okay";
	pinctrl-0 = <&uart3_tx_ph05 &uart3_rx_ph04>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

&cap {
    prescaler = <7>;
    channels = <CAP_DISABLED CAP_DISABLED CAP_MODE0 CAP_MODE1 CAP_MODE1 CAP_MODE1 CAP_MODE1 CAP_MODE1>;//cap_mode
    pinctrl-0 = <&cap1_rx_pf00 &cap2_rx_pf01 &cap3_rx_pf02 &cap4_rx_pf03 &cap5_rx_pf04
                 &cap6_rx_pf05 &cap7_rx_pf06 &cap8_rx_pf07>;
    pinctrl-names = "default";
};

&pwm {
	status = "okay";
	prescaler = <7>;
    pinctrl-0 = <&pwm1_tx_pe06 &pwm2_tx_pe07 &pwm3_tx_pe08 &pwm4_tx_pe09 &pwm5_tx_pe10
                 &pwm6_tx_pe11 &pwm7_tx_pe12 &pwm8_tx_pe15>;
    pinctrl-names = "default";
};
&dwuart1 {
	status = "disabled";
	pinctrl-0 = <&dwuart1_tx_pb06 &dwuart1_rx_pb07>;
	pinctrl-names = "default";
	current-speed = <921600>;
};

&dwuart2 {
	status = "disabled";
	pinctrl-0 = <&dwuart2_tx_pb08 &dwuart2_rx_pb09>;
	pinctrl-names = "default";
	current-speed = <921600>;
};

&adc1 {
	status = "disabled";
	pinctrl-0 = <&adc1_in5_pa14>;
	pinctrl-names = "default";
};

&adc2 {
	status = "disabled";
	pinctrl-0 = <&adc2_in5_ph13>;
	// pinctrl-0 = <&amic_pa00>;
	pinctrl-names = "default";
};

&dac12 {
	status = "disabled";
	pinctrl-0 = <&dac1_out1_pa02>;
	pinctrl-names = "default";
};

&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_sck_pe00 &spi1_nss_pe01
	             &spi1_mosi_pe02 &spi1_miso_pe03>;
	pinctrl-names = "default";

	cs-gpios = <&gpioe 1 GPIO_ACTIVE_LOW>;
};

&spi2 {
	status = "disabled";
	pinctrl-0 = <&spi2_sck_pb12 &spi2_nss_pb13
	             &spi2_mosi_pb14 &spi2_miso_pb15>;
	pinctrl-names = "default";

	cs-gpios = <&gpiob 13 GPIO_ACTIVE_LOW>;
};

&spi3 {
	status = "disabled";
	pinctrl-0 = <&spi3_sck_pa12 &spi3_nss_pa13
	             &spi3_mosi_pa14 &spi3_miso_pa15>;
	pinctrl-names = "default";

	cs-gpios = <&gpioa 13 GPIO_ACTIVE_LOW>;
};

&iwdgt
{
	status = "okay";
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_scl_pa08 &i2c1_sda_pa09>;
	pinctrl-names = "default";
};

&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_scl_pa10 &i2c2_sda_pa11>;
	pinctrl-names = "default";
};

&i2c1 {
	eeprom1: eeprom@50 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x50>;
		size = <256>;
	};
};

&i2c2 {
	eeprom2: eeprom@50 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x50>;
		size = <256>;
	};
};

&espi {
	e8042: e8042 {
		compatible = "linkedsemi,ls-kcs";
		port = <0x60 0x64>;
		up-irq = <1 0>;
		status = "okay";
	};


	status = "okay";
};

&peci0 {
	status = "okay";
	pinctrl-0 = <&peci_default_pc04>;
	pinctrl-names = "default";
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&gpioc {
	status = "okay";
};

&gpiod {
	status = "okay";
};

&gpioe {
	status = "okay";
};

&gpiof {
	status = "okay";
};

&gpiog {
	status = "okay";
};

&gpioh {
	status = "okay";
};

