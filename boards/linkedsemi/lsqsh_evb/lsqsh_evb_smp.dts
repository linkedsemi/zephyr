&sdhci1 {
    status = "okay";

    mmc_disk1: disk {
        compatible = "zephyr,mmc-disk";
        /* samples/subsys/fs/fs_sample/ assert disk-name to SD2 */
        disk-name = "SD2";
        bus-width = <8>;
        status = "okay";
    };
};

zephyr_udc0: &usb2 {
    status = "okay";
};

&i2c5 {
    status = "okay";
    eeprom_5_1: eeprom@50 {
        compatible = "atmel,at24";
        reg = <0x50>;
        size = <4096>;
        pagesize = <32>;
        address-width = <16>;
        timeout = <5>;
    };
};