&uart1 {
    current-speed = <115200>;
    status = "okay";
};

&uart3 {
    current-speed = <115200>;
    status = "disabled";
};

&uart4 {
    current-speed = <115200>;
    status = "disabled";
};

&sec_iwdg {
    status = "okay";
};

&pmu_iwdg {
    status = "okay";
};

