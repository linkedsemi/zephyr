/dts-v1/;
#include <riscv/linkedsemi/lsqsh.dtsi>
#include <arch/riscv/csr.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "lsqsh_evb_pinctrl.dtsi"
#include <zephyr/dt-bindings/adc/ls-adc.h>
#define BTN_GPIO_FLAGS (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)


#define SRAM_TOTAL_SIZE DT_SIZE_K(1280)

&chosen {
    zephyr,flash = &sram;
    zephyr,flash-controller = &qspi1;
    zephyr,sram = &sram;
    zephyr,console = &uart1;
    zephyr,shell-uart = &uart1;
};

&aliases {
    sdhc0 = &sdhci1;
    watchdog0 = &sec_iwdg;
    // peci-0 = &peci1;
    // sw0 = &btn1;
    // led0 = &led1;
    // pwm-led0 = &pwm_led0;
};

&soc {
    /delete-node/ memory@10000000;
    sram: memory@10000000 {
        compatible = "mmio-sram";
        reg = <0x10000000 SRAM_TOTAL_SIZE>;
    };

    driver_share_memory: memory@100be000 {
        compatible = "zephyr,memory-region", "mmio-sram";
        reg = <0x100be000 0x1000>;
        zephyr,memory-region = "SHMEM";
    };

    qspi1: qspi@40000000 {
        compatible = "linkedsemi,ls-flash-controller";
        reg = <0x40000000 0x400>;
        #address-cells = <1>;
        #size-cells = <1>;
        interrupts = <3 3>;
        quad_mode;
        continuous_mode;
        // mbox = <&mbox_consumer_qspi1>;

        flash1: flash@8000000 {
            compatible = "soc-nv-flash";
            reg = <0x8000000 DT_SIZE_M(32)>;
            erase-block-size = <4096>;
            write-block-size = <4>;
        };
    };
};

&cpu1 {
    status = "okay";
};

&cpu2 {
    status = "okay";
};

&gpioa {
    status = "okay";
};

&gpiob {
    status = "okay";
