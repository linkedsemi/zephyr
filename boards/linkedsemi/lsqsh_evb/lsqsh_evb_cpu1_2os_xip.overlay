#include "lsqsh_evb_pinctrl.dtsi"

/ {
    chosen {
        zephyr,flash = &flash1;
        zephyr,flash-controller = &qspi1;
        zephyr,sram = &sram1;
        zephyr,console = &uart3;
        zephyr,shell-uart = &uart3;
    };
};

&sram1 {
    reg = <0x10000000 DT_SIZE_K(512)>;
};

&sram2 {
    status = "disabled";
};

