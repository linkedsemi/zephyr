#include "lsqsh_evb_pinctrl.dtsi"

/ {
    chosen {
        zephyr,flash = &sram1_ro;
        zephyr,flash-controller = &qspi1;
        zephyr,sram = &sram1;
        zephyr,console = &uart1;
        zephyr,shell-uart = &uart1;
    };

    /delete-node/ memory@10000000;
    sram1_ro: memory@10000000 {
        compatible = "mmio-sram";
        reg = <0x10000000 DT_SIZE_K(256)>;
    };

    sram1: memory@10040000 {
        compatible = "mmio-sram";
        reg = <(0x10000000 + DT_SIZE_K(256)) (DT_SIZE_K(512) - DT_SIZE_K(256))>;
    };
};

&sram2 {
    status = "disabled";
};

&uart1 {
    current-speed = <115200>;
    status = "okay";
};

&uart2 {
    current-speed = <115200>;
    status = "disabled";
};

&uart3 {
    current-speed = <115200>;
    status = "disabled";
};

&uart4 {
    current-speed = <115200>;
    status = "disabled";
};

&uart5 {
    current-speed = <115200>;
    status = "disabled";
};

