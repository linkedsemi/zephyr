/dts-v1/;
#include <riscv/linkedsemi/lsqsh.dtsi>
#include <zephyr/dt-bindings/pinctrl/lsqsh-pinctrl.h>
#include "lsqsh_pinctrl_common.dtsi"

#define BTN_GPIO_FLAGS (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)

/ {
    model = "linkedsemi LSQSH_EVB";
    compatible = "linkedsemi,lsqsh_app_evb";

    chosen {
        zephyr,sram = &sram1;
        zephyr,console = &uart4;
        zephyr,shell-uart = &uart4;
    };

    aliases {
        sdhc0 = &sdhci;
    };

    sram1_nocache: memory@1013e000 {
        compatible = "zephyr,memory-region", "mmio-sram";
        reg = <0x1013e000 DT_SIZE_K(4)>;
        device_type = "memory";
        zephyr,memory-region = "nocache";
    };

    soc {
        compatible = "simpe-bus";
        #address-cells = <1>;
        #size-cells = <1>;
        interrupt-parent = <&intc>;

        mbox: mbox@1013f000 {
            compatible = "linkedsemi,mbox";
            reg = <0x1013f000 0x1000>;
            interrupts = <26 3>;
            nchannels = <2>;
            fifo-deepth = <3>;
            fifo-width = <4>;
            #mbox-cells = <1>;
        };
    };

    mbox_consumer0: mbox-consumer0 {
        compatible = "vnd,mbox-consumer";
        mboxes = <&mbox 0>, <&mbox 1>;
        mbox-names = "tx", "rx";
    };

    mbox_consumer1: mbox-consumer1 {
        compatible = "vnd,mbox-consumer";
        mboxes = <&mbox 2>, <&mbox 3>;
        mbox-names = "tx", "rx";
    };
};

&cpu0 {
    status = "disabled";
};

&cpu1 {
    clock-frequency = <50000000>;
    cpu-power-states = <&idle &lp0>;
};

&sram0 {
    status = "disabled";
};

&sram1 {
    reg = <0x10080000 DT_SIZE_K(760)>;
};

&mac0 {
    pinctrl-0 = <&rmii_txen_pt03
                &rmii_txd0_pt04
                &rmii_txd1_pt05
                &rmii_rxc_pt08
                &rmii_crsdv_pt09
                &rmii_rxd0_pt10
                &rmii_rxd1_pt11>;
    pinctrl-names = "default";
    status = "okay";
};

&mdio0 {
    pinctrl-0 = <&rmii_mdc_pt00
                &rmii_mdio_pt01>;
    pinctrl-names = "default";
    status = "okay";
};

&sdhci {
    pinctrl-0 = <&sdhc_d0_ph04
                &sdhc_d1_ph05
                &sdhc_d2_ph06
                &sdhc_d3_ph07
                &sdhc_d4_ph08
                &sdhc_d5_ph09
                &sdhc_d6_ph010
                &sdhc_d7_ph011
                &sdhc_clk_ph012
                &sdhc_cmd_ph013>;
    pinctrl-names = "default";
    status = "okay";

    mmc_disk0: disk {
        compatible = "zephyr,mmc-disk";
        bus-width = <1>;
        status = "okay";
    };
};
