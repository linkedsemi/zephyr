&eth1 {
    status = "okay";
};

&mdio1 {
    status = "okay";
};

&peci1 {
    status = "okay";
};

&sdhci1 {
    status = "okay";

    mmc_disk1: disk {
        compatible = "zephyr,mmc-disk";
        /* samples/subsys/fs/fs_sample/ assert disk-name to SD2 */
        disk-name = "SD2";
        bus-width = <1>;
        status = "okay";
    };
};

&aes256 {
    status = "okay";
};

&sha256 {
    status = "okay";
};

&sha512 {
    status = "okay";
};

&sm4 {
    status = "okay";
};

// tst_dma0: &dma0 {
//     status = "okay";
// };

&lpc1 {
    status = "disabled";

    lpc_kcs_ca2: lpc_kcs_ca2 {
        compatible = "linkedsemi,ls-kcs";
        port = <0xca2 0xca3>;
        status = "disabled";
    };
};

&espi1 {
    espi1_kcs_ca2: espi1_kcs_ca2 {
        compatible = "linkedsemi,ls-kcs";
        port = <0xca2 0xca3>;
        status = "okay";
    };
};

&ipmi_kcs {
    kcs_chan = <&espi1_kcs_ca2>;
    status = "okay";
};
