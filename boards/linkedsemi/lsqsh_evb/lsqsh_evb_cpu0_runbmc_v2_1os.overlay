#include "lsqsh_evb_pinctrl_runbmc_v2.dtsi"

/delete-node/ &sram0_nocache;
/delete-node/ &mac0;
/ {
    interrupt-parent = <&intc>;

    chosen {
        zephyr,flash = &flash0;
        zephyr,flash-controller = &qspi1;
        zephyr,sram = &sram0;
        zephyr,console = &uart3;
        zephyr,shell-uart = &uart3;
    };

    sram0_nocache: memory@1013e000{
        compatible = "zephyr,memory-region", "mmio-sram";
        reg = <0x1013e000 DT_SIZE_K(4)>;
        device_type = "memory";
        zephyr,memory-region = "nocache";
    };

    mac0: ethernet@4001c000 {
        compatible = "linkedsemi,ethernet", "snps,designware-ethernet";
        reg = <0x4001c000 0x2000>;
        interrupts = <40 3>;
        status = "disabled";

        mdio0: mdio {
            compatible = "snps,dwmac-mdio";
            #address-cells = <1>;
            #size-cells = <0>;
            status = "disabled";
        };
    };
};

&cpu1 {
    status = "disabled";
};

&sram0 {
    reg = <0x30000000 DT_SIZE_K(512 + 764)>;
};

&sram1 {
    status = "disabled";
};

&mbox {
    status = "disabled";
};

&mbox_consumer0 {
    status = "disabled";
};

&mbox_consumer1 {
    status = "disabled";
};

&uart1 {
    current-speed = <115200>;
    status = "disabled";
};

&uart2 {
    current-speed = <115200>;
    status = "disabled";
};

&uart3 {
    current-speed = <115200>;
    pinctrl-0 = <&uart3_tx_pc03 &uart3_rx_pc04>;
    pinctrl-names = "default";
    status = "okay";
};

&uart4 {
    current-speed = <115200>;
    pinctrl-0 = <&uart4_tx_pd09 &uart4_rx_pd10>;
    pinctrl-names = "default";
    status = "disabled";
};

