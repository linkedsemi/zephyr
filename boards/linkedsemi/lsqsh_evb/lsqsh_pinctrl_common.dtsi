#include <zephyr/dt-bindings/pinctrl/lsqsh-pinctrl.h>

&pinctrl {
    /* RGMII1 */
    /omit-if-no-ref/rmii_mdc_pa14: rmii_mdc_pa14 {
        pinmux = <LS_PINMUX_RGMII1_MDC_FUNC2_PA14>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/rmii_mdio_pa15: rmii_mdio_pa15 {
        pinmux = <LS_PINMUX_RGMII1_MDIO_FUNC2_PA15>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/rgmii_txck_pt03: rgmii_txck_pt03 {
        pinmux = <LS_PINMUX_RGMII1_TXCK_FUNC3_PT03>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/rmii_txen_pt04: rmii_txen_pt04 {
        pinmux = <LS_PINMUX_RGMII1_TXCTL_FUNC3_PT04>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/rmii_txd0_pt05: rmii_txd0_pt05 {
        pinmux = <LS_PINMUX_RGMII1_TXD0_FUNC3_PT05>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/rmii_txd1_pt06: rmii_txd1_pt06 {
        pinmux = <LS_PINMUX_RGMII1_TXD1_FUNC3_PT06>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/rgmii_txd2_pt07: rgmii_txd2_pt07 {
        pinmux = <LS_PINMUX_RGMII1_TXD2_FUNC3_PT07>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/rgmii_txd3_pt08: rgmii_txd3_pt08 {
        pinmux = <LS_PINMUX_RGMII1_TXD3_FUNC3_PT08>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/rmii_rxc_pt10: rmii_rxc_pt10 {
        pinmux = <LS_PINMUX_RGMII1_RXCK_FUNC3_PT10>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/rmii_crsdv_pt11: rmii_crsdv_pt11 {
        pinmux = <LS_PINMUX_RGMII1_RXCTL_FUNC3_PT11>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/rmii_rxd0_pt12: rmii_rxd0_pt12 {
        pinmux = <LS_PINMUX_RGMII1_RXD0_FUNC3_PT12>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/rmii_rxd1_pt13: rmii_rxd1_pt13 {
        pinmux = <LS_PINMUX_RGMII1_RXD1_FUNC3_PT13>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/rgmii_rxd2_pt14: rgmii_rxd2_pt14 {
        pinmux = <LS_PINMUX_RGMII1_RXD2_FUNC3_PT14>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/rgmii_rxd3_pt15: rgmii_rxd3_pt15 {
        pinmux = <LS_PINMUX_RGMII1_RXD3_FUNC3_PT15>;
        drive-strength = "quarter max driver";
        input-enable;
    };

    /* SDHC1 */
    /omit-if-no-ref/sdhc_d0_pm04: sdhc_d0_pm04 {
        pinmux = <LS_PINMUX_EMMC_DAT0_FUNC4_PM04>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/sdhc_d1_pm05: sdhc_d1_pm05 {
        pinmux = <LS_PINMUX_EMMC_DAT1_FUNC4_PM05>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/sdhc_d2_pm06: sdhc_d2_pm06 {
        pinmux = <LS_PINMUX_EMMC_DAT2_FUNC4_PM06>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/sdhc_d3_pm07: sdhc_d3_pm07 {
        pinmux = <LS_PINMUX_EMMC_DAT3_FUNC4_PM07>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/sdhc_d4_pm08: sdhc_d4_pm08 {
        pinmux = <LS_PINMUX_EMMC_DAT4_FUNC4_PM08>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/sdhc_d5_pm09: sdhc_d5_pm09 {
        pinmux = <LS_PINMUX_EMMC_DAT5_FUNC4_PM09>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/sdhc_d6_pm10: sdhc_d6_pm10 {
        pinmux = <LS_PINMUX_EMMC_DAT6_FUNC4_PM10>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/sdhc_d7_pm11: sdhc_d7_pm11 {
        pinmux = <LS_PINMUX_EMMC_DAT7_FUNC4_PM11>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/sdhc_clk_pm12: sdhc_clk_pm12 {
        pinmux = <LS_PINMUX_EMMC_CLK_FUNC4_PM12>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/sdhc_cmd_pm13: sdhc_cmd_pm13 {
        pinmux = <LS_PINMUX_EMMC_CMD_FUNC4_PM13>;
        drive-strength = "quarter max driver";
        input-enable;
    };

    /* QSPI1 */
    /omit-if-no-ref/qspi1_sck_pa00: qspi1_sck_pa00 {
        pinmux = <LS_PINMUX_QSPI1_SCK_FUNC3_PA00>;
        output-enable;
    };
    /omit-if-no-ref/qspi1_csn_pa01: qspi1_csn_pa01 {
        pinmux = <LS_PINMUX_QSPI1_CSN_FUNC3_PA01>;
        output-enable;
        input-enable;
    };
    /omit-if-no-ref/qspi1_dq0_pa02: qspi1_dq0_pa02 {
        pinmux = <LS_PINMUX_QSPI1_DAT0_FUNC3_PA02>;
        input-enable;
    };
    /omit-if-no-ref/qspi1_dq1_pa03: qspi1_dq1_pa03 {
        pinmux = <LS_PINMUX_QSPI1_DAT1_FUNC3_PA03>;
        input-enable;
    };
    /omit-if-no-ref/qspi1_dq2_pa04: qspi1_dq2_pa04 {
        pinmux = <LS_PINMUX_QSPI1_DAT2_FUNC3_PA04>;
        input-enable;
    };
    /omit-if-no-ref/qspi1_dq3_pa05: qspi1_dq3_pa05 {
        pinmux = <LS_PINMUX_QSPI1_DAT3_FUNC3_PA05>;
        input-enable;
    };

    // /* eSPI */
