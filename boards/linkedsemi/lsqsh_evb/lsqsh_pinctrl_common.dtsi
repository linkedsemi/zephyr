    //     pinmux = <LS_PINMUX_SET(PI14,  LSFUNC(PINMUX_FUNC2))>;
    //     input-enable;
    // };
    // /omit-if-no-ref/espi1_dat0_pi15: espi1_dat0_pi15 {
    //     pinmux = <LS_PINMUX_SET(PI15,  LSFUNC(PINMUX_FUNC2))>;
    //     input-enable;
    // };

    // /* eSPI */
    // /omit-if-no-ref/espi2_alertn_ph04: espi2_alertn_ph04 {
    //     pinmux = <LS_PINMUX_SET(PH04,  LSFUNC(PINMUX_FUNC2))>;
    // };
    // /omit-if-no-ref/espi2_csn_ph05: espi2_csn_ph05 {
    //     pinmux = <LS_PINMUX_SET(PH05,  LSFUNC(PINMUX_FUNC2))>;
    //     input-enable;
    // };
    // /omit-if-no-ref/espi2_sck_ph06: espi2_sck_ph06 {
    //     pinmux = <LS_PINMUX_SET(PH06,  LSFUNC(PINMUX_FUNC2))>;
    //     input-enable;
    // };
    // /omit-if-no-ref/espi2_dat3_ph07: espi2_dat3_ph07 {
