    /omit-if-no-ref/i2c7_scl_pg11: i2c7_scl_pg11 {
        pinmux = <I2C7_SCL_FUNC1_IDX10_PINMUX_PG(11)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c7_sda_pg10: i2c7_sda_pg10 {
        pinmux = <I2C7_SDA_FUNC1_IDX11_PINMUX_PG(10)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
