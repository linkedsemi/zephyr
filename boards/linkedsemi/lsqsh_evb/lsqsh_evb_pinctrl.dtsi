&uart1 {
    pinctrl-0 = <&uart1_tx_pn04 &uart1_rx_pn03>;
    pinctrl-names = "default";
};

&uart3 {
    pinctrl-0 = <&uart3_tx_pn04 &uart3_rx_pn03>;
    pinctrl-names = "default";
};

&uart4 {
    pinctrl-0 = <&uart4_tx_pd11 &uart4_rx_pd12>;
    pinctrl-names = "default";
};

&uart7 {
    pinctrl-0 = <&uart7_tx_pg13 &uart7_rx_pg15>;
    pinctrl-names = "default";
};

&i2c2 {
    pinctrl-0 = <&i2c2_scl_pb00 &i2c2_sda_pb01>;
    pinctrl-names = "default";
};

&i2c5 {
    pinctrl-0 = <&i2c5_scl_pe01 &i2c5_sda_pe06>;
    pinctrl-names = "default";
};

