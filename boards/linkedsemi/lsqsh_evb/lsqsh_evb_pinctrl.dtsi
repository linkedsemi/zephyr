#include <zephyr/dt-bindings/pinctrl/lsqsh-pinctrl.h>

&pinctrl {
    /* UART */
    /omit-if-no-ref/uart1_tx_pn04: uart1_tx_pn04 {
        pinmux = <UART1_TXD_FUNC1_IDX16_PINMUX_PN(04)>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/uart1_rx_pn03: uart1_rx_pn03 {
        pinmux = <UART1_RXD_FUNC1_IDX17_PINMUX_PN(03)>;
        drive-strength = "quarter max driver";
        input-enable;
    };

    /omit-if-no-ref/uart3_tx_pn04: uart3_tx_pn04 {
        pinmux = <UART3_TXD_FUNC1_IDX20_PINMUX_PN(04)>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/uart3_rx_pn03: uart3_rx_pn03 {
        pinmux = <UART3_RXD_FUNC1_IDX21_PINMUX_PN(03)>;
        drive-strength = "quarter max driver";
        input-enable;
    };

    /omit-if-no-ref/uart4_tx_pd11: uart4_tx_pd11 {
        pinmux = <UART4_TXD_FUNC1_IDX09_PINMUX_PD(11)>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/uart4_rx_pd12: uart4_rx_pd12 {
        pinmux = <UART4_RXD_FUNC1_IDX10_PINMUX_PD(12)>;
        drive-strength = "quarter max driver";
        input-enable;
    };

    /omit-if-no-ref/uart5_tx_pe00: uart5_tx_pe00 {
        pinmux = <UART5_TXD_FUNC1_IDX09_PINMUX_PE(00)>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/uart5_rx_pe01: uart5_rx_pe01 {
        pinmux = <UART5_RXD_FUNC1_IDX10_PINMUX_PE(01)>;
        drive-strength = "quarter max driver";
        input-enable;
    };

    /omit-if-no-ref/uart6_tx_pf10: uart6_tx_pf10 {
        pinmux = <UART6_TXD_FUNC1_IDX08_PINMUX_PF(10)>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/uart6_rx_pf02: uart6_rx_pf02 {
        pinmux = <UART6_RXD_FUNC1_IDX09_PINMUX_PF(02)>;
        drive-strength = "quarter max driver";
        input-enable;
    };

    /omit-if-no-ref/uart7_tx_pg13: uart7_tx_pg13 {
        pinmux = <UART7_TXD_FUNC1_IDX13_PINMUX_PG(13)>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/uart7_rx_pg15: uart7_rx_pg15 {
        pinmux = <UART7_RXD_FUNC1_IDX14_PINMUX_PG(15)>;
        drive-strength = "quarter max driver";
        input-enable;
    };

    // /* I2C */
    /omit-if-no-ref/i2c2_scl_pb00: i2c2_scl_pb00 {
        pinmux = <I2C2_SCL_FUNC1_IDX10_PINMUX_PB(00)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c2_sda_pb01: i2c2_sda_pb01 {
        pinmux = <I2C2_SDA_FUNC1_IDX11_PINMUX_PB(01)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c5_scl_pe01: i2c5_scl_pe01 {
        pinmux = <I2C5_SCL_FUNC1_IDX06_PINMUX_PE(01)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c5_sda_pe06: i2c5_sda_pe06 {
        pinmux = <I2C5_SDA_FUNC1_IDX07_PINMUX_PE(06)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c6_scl_pf07: i2c6_scl_pf07 {
        pinmux = <I2C6_SCL_FUNC1_IDX05_PINMUX_PF(07)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c6_sda_pf08: i2c6_sda_pf08 {
        pinmux = <I2C6_SDA_FUNC1_IDX06_PINMUX_PF(08)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c7_scl_pg11: i2c7_scl_pg11 {
        pinmux = <I2C7_SCL_FUNC1_IDX10_PINMUX_PG(11)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c7_sda_pg10: i2c7_sda_pg10 {
        pinmux = <I2C7_SDA_FUNC1_IDX11_PINMUX_PG(10)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c8_scl_ph05: i2c8_scl_ph05 {
        pinmux = <I2C8_SCL_FUNC1_IDX10_PINMUX_PH(05)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c8_sda_ph07: i2c8_sda_ph07 {
        pinmux = <I2C8_SDA_FUNC1_IDX11_PINMUX_PH(07)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c9_scl_pi02: i2c9_scl_pi02 {
        pinmux = <I2C9_SCL_FUNC1_IDX06_PINMUX_PI(02)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c9_sda_pi03: i2c9_sda_pi03 {
        pinmux = <I2C9_SDA_FUNC1_IDX07_PINMUX_PI(03)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c10_scl_pj06: i2c10_scl_pj06 {
        pinmux = <I2C10_SCL_FUNC1_IDX06_PINMUX_PJ(06)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c10_sda_pj07: i2c10_sda_pj07 {
        pinmux = <I2C10_SDA_FUNC1_IDX07_PINMUX_PJ(07)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c11_scl_pk15: i2c11_scl_pk15 {
        pinmux = <I2C11_SCL_FUNC1_IDX06_PINMUX_PK(15)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c11_sda_pk01: i2c11_sda_pk01 {
        pinmux = <I2C11_SDA_FUNC1_IDX07_PINMUX_PK(01)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c12_scl_pm14: i2c12_scl_pm14 {
        pinmux = <I2C12_SCL_FUNC1_IDX05_PINMUX_PM(14)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c12_sda_pm15: i2c12_sda_pm15 {
        pinmux = <I2C12_SDA_FUNC1_IDX06_PINMUX_PM(15)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c13_scl_pn14: i2c13_scl_pn14 {
        pinmux = <I2C13_SCL_FUNC1_IDX10_PINMUX_PN(14)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c13_sda_pn06: i2c13_sda_pn06 {
        pinmux = <I2C13_SDA_FUNC1_IDX11_PINMUX_PN(06)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c14_scl_pn13: i2c14_scl_pn13 {
        pinmux = <I2C14_SCL_FUNC1_IDX13_PINMUX_PN(13)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c14_sda_pn00: i2c14_sda_pn00 {
        pinmux = <I2C14_SDA_FUNC1_IDX14_PINMUX_PN(00)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c15_scl_pq14: i2c15_scl_pq14 {
        pinmux = <I2C15_SCL_FUNC1_IDX10_PINMUX_PQ(14)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c15_sda_pq15: i2c15_sda_pq15 {
        pinmux = <I2C15_SDA_FUNC1_IDX11_PINMUX_PQ(15)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c16_scl_pq12: i2c16_scl_pq12 {
        pinmux = <I2C16_SCL_FUNC1_IDX13_PINMUX_PQ(12)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c16_sda_pq11: i2c16_sda_pq11 {
        pinmux = <I2C16_SDA_FUNC1_IDX14_PINMUX_PQ(11)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/spi1_clk_pa02: spi1_clk_pa02 {
        pinmux = <SPI1_SCK_FUNC1_IDX18_PINMUX_PA(02)>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/spi1_miso_pa01: spi1_miso_pa01 {
        pinmux = <SPI1_MISO_FUNC1_IDX21_PINMUX_PA(01)>;
        drive-strength = "quarter max driver";
        input-enable;
    };
    /omit-if-no-ref/spi1_mosi_pa04: spi1_mosi_pa04 {
        pinmux = <SPI1_MOSI_FUNC1_IDX20_PINMUX_PA(04)>;
        drive-strength = "quarter max driver";
    };

    /omit-if-no-ref/spi4_mst_clk_pq00: spi4_mst_clk_pq00 {
        pinmux = <SPI4_SCK_FUNC4_PQ00_PINMUX>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/spi4_mst_io0_pq03: spi4_mst_io0_pq03 {
        pinmux = <SPI4_DAT0_FUNC4_PQ03_PINMUX>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/spi4_mst_io1_pq04: spi4_mst_io1_pq04 {
        pinmux = <SPI4_DAT1_FUNC4_PQ04_PINMUX>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/spi4_mst_io2_pq05: spi4_mst_io2_pq05 {
        pinmux = <SPI4_DAT2_FUNC4_PQ05_PINMUX>;
        drive-strength = "quarter max driver";
    };
    /omit-if-no-ref/spi4_mst_io3_pq06: spi4_mst_io3_pq06 {
        pinmux = <SPI4_DAT3_FUNC4_PQ06_PINMUX>;
        drive-strength = "quarter max driver";
    };
};

&uart1 {
    pinctrl-0 = <&uart1_tx_pn04 &uart1_rx_pn03>;
    pinctrl-names = "default";
};

&uart3 {
    pinctrl-0 = <&uart3_tx_pn04 &uart3_rx_pn03>;
    pinctrl-names = "default";
};

&uart4 {
    pinctrl-0 = <&uart4_tx_pd11 &uart4_rx_pd12>;
    pinctrl-names = "default";
};

&uart6 {
    pinctrl-0 = <&uart6_tx_pf10 &uart6_rx_pf02>;
    pinctrl-names = "default";
};

&uart7 {
    pinctrl-0 = <&uart7_tx_pg13 &uart7_rx_pg15>;
    pinctrl-names = "default";
};

&i2c2 {
    pinctrl-0 = <&i2c2_scl_pb00 &i2c2_sda_pb01>;
    pinctrl-names = "default";
};

&i2c5 {
    pinctrl-0 = <&i2c5_scl_pe01 &i2c5_sda_pe06>;
    pinctrl-names = "default";
};

&i2c6 {
    pinctrl-0 = <&i2c6_scl_pf07 &i2c6_sda_pf08>;
    pinctrl-names = "default";
};

&i2c7 {
    pinctrl-0 = <&i2c7_scl_pg11 &i2c7_sda_pg10>;
    pinctrl-names = "default";
};

&i2c8 {
    pinctrl-0 = <&i2c8_scl_ph05 &i2c8_sda_ph07>;
    pinctrl-names = "default";
};

&i2c9 {
    pinctrl-0 = <&i2c9_scl_pi02 &i2c9_sda_pi03>;
    pinctrl-names = "default";
};

&i2c10 {
    pinctrl-0 = <&i2c10_scl_pj06 &i2c10_sda_pj07>;
    pinctrl-names = "default";
};

&i2c11 {
    pinctrl-0 = <&i2c11_scl_pk15 &i2c11_sda_pk01>;
    pinctrl-names = "default";
};

&i2c12 {
    pinctrl-0 = <&i2c12_scl_pm14 &i2c12_sda_pm15>;
    pinctrl-names = "default";
};

&i2c13 {
    pinctrl-0 = <&i2c13_scl_pn14 &i2c13_sda_pn06>;
    pinctrl-names = "default";
};

&i2c14 {
    pinctrl-0 = <&i2c14_scl_pn13 &i2c14_sda_pn00>;
    pinctrl-names = "default";
};

&i2c15 {
    pinctrl-0 = <&i2c15_scl_pq14 &i2c15_sda_pq15>;
    pinctrl-names = "default";
};

&i2c16 {
    pinctrl-0 = <&i2c16_scl_pq12 &i2c16_sda_pq11>;
    pinctrl-names = "default";
};

&spi1 {
    pinctrl-0 = <&spi1_clk_pa02 &spi1_miso_pa01 &spi1_mosi_pa04>;
    pinctrl-names = "default";
};

&spi4 {
    cs-gpios = <&gpioq 0 GPIO_ACTIVE_LOW>;
    pinctrl-0 = <
        &spi4_mst_clk_pq00
        &spi4_mst_io0_pq03
        &spi4_mst_io1_pq04
        // &spi4_mst_io2_pq05
        // &spi4_mst_io3_pq06
    >;
    pinctrl-names = "default";
};
