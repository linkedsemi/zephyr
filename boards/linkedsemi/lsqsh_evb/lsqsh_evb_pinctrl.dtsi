    /omit-if-no-ref/i2c11_scl_pk15: i2c11_scl_pk15 {
        pinmux = <I2C11_SCL_FUNC1_IDX06_PINMUX_PK(15)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c11_sda_pk01: i2c11_sda_pk01 {
        pinmux = <I2C11_SDA_FUNC1_IDX07_PINMUX_PK(01)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c12_scl_pm14: i2c12_scl_pm14 {
        pinmux = <I2C12_SCL_FUNC1_IDX05_PINMUX_PM(14)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c12_sda_pm15: i2c12_sda_pm15 {
        pinmux = <I2C12_SDA_FUNC1_IDX06_PINMUX_PM(15)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };

    /omit-if-no-ref/i2c13_scl_pn14: i2c13_scl_pn14 {
        pinmux = <I2C13_SCL_FUNC1_IDX10_PINMUX_PN(14)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c13_sda_pn06: i2c13_sda_pn06 {
        pinmux = <I2C13_SDA_FUNC1_IDX11_PINMUX_PN(06)>;
