        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
    };
    /omit-if-no-ref/i2c5_sda_pe06: i2c5_sda_pe06 {
        pinmux = <I2C5_SDA_FUNC1_IDX07_PINMUX_PE(06)>;
        drive-strength = "quarter max driver";
        drive-open-drain;
        input-enable;
