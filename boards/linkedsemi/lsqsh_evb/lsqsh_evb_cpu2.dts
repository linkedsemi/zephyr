/dts-v1/;
#include <riscv/linkedsemi/lsqsh.dtsi>
#include "lsqsh_evb_pinctrl.dtsi"

#define BTN_GPIO_FLAGS (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)

/ {
    model = "linkedsemi LSQSH_EVB";
    compatible = "linkedsemi,lsqsh_app_evb";

    chosen {
        zephyr,sram = &sram2;
        zephyr,console = &uart4;
        zephyr,shell-uart = &uart4;
        zephyr,flash-controller = &qspi1;
        zephyr,internal-flash = &flash1;
    };

    aliases {
        sdhc0 = &sdhci1;
    };

    soc {
        compatible = "simpe-bus";
        #address-cells = <1>;
        #size-cells = <1>;
        interrupt-parent = <&intc>;

        share_memory: share-memory@1013e000 {
            compatible = "zephyr,memory-region", "mmio-sram";
            reg = <0x1013e000 DT_SIZE_K(4)>;
            zephyr,memory-region = "SHMEM";
        };

        mbox: mbox@1013f000 {
            compatible = "linkedsemi,mbox";
            reg = <0x1013f000 DT_SIZE_K(4)>;
            fifo-deepth = <2>;
            fifo-width = <256>;
            #mbox-cells = <1>;

            interrupts = <SYSC_APP_CPU_IRQN 3>;

            mbox_consumer_qspi1: mbox-consumer_qspi1 {
                compatible = "vnd,mbox-consumer";
                mboxes = <&mbox 0>, <&mbox 1>;
                mbox-names = "tx", "rx";
            };
        };

        qspi1: qspi@40000000 {
            compatible = "linkedsemi,ls-flash-delegation-client";
            reg = <0x40000000 0x400>;
            #address-cells = <1>;
            #size-cells = <1>;
            interrupts = <3 3>;
            mbox = <&mbox_consumer_qspi1>;

            flash1: flash@8000000 {
                compatible = "soc-nv-flash";
                reg = <0x8000000 DT_SIZE_M(32)>;
                erase-block-size = <4096>;
                write-block-size = <4>;
            };
        };
    };
};

&cpu1 {
    status = "disabled";
};

&cpu2 {
    status = "okay";
};

&sram1 {
    status = "disabled";
};

&sram2 {
    reg = <0x10080000 DT_SIZE_K(760)>;
};

&uart1 {
    current-speed = <115200>;
    status = "disabled";
};

&uart2 {
    current-speed = <115200>;
    status = "disabled";
};

&uart3 {
    current-speed = <115200>;
    status = "disabled";
};

&uart4 {
    current-speed = <115200>;
    status = "okay";
};

&uart5 {
    current-speed = <115200>;
    status = "disabled";
};

&psram {
    status = "okay";
};

&gpioa {
    status = "okay";
};

&gpiob {
    status = "okay";
};

&gpioc {
    status = "okay";
};

&gpiod {
    status = "okay";
};

&gpioe {
    status = "okay";
};

&gpiof {
    status = "okay";
};

&gpiog {
    status = "okay";
};

&gpioh {
    status = "okay";
};

&gpioi {
    status = "okay";
};

&gpioj {
    status = "okay";
};

&gpiok {
    status = "okay";
};

&gpiom {
    status = "okay";
};

&gpion {
    status = "okay";
};

&gpioq {
    status = "okay";
};

&gpiot {
    status = "okay";
};

&eth1 {
    phy-handle = <&eth1_phy>;
    status = "okay";
};

&mdio1 {
    status = "okay";
    reset-gpios = <&gpiog 1 GPIO_ACTIVE_HIGH>;
    reset-hold-ms = <10>;
    circuits-set-ms = <30>;
    eth1_phy: ethernet-phy@0 {
        compatible = "realtek,rtl8211f";
        reg = <0>;
        reset-gpios = <&gpiog 1 GPIO_ACTIVE_HIGH>;
        int-gpios = <&gpiog 5 GPIO_ACTIVE_LOW>;
        status = "okay";
    };
};

&sdhci1 {
    status = "okay";

    mmc_disk1: disk {
        compatible = "zephyr,mmc-disk";
        /* samples/subsys/fs/fs_sample/ assert disk-name to SD2 */
        disk-name = "SD2";
        bus-width = <1>;
        status = "okay";
    };
};
