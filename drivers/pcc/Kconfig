menuconfig PCC
    bool "PCC (post code capture) drivers"
    help
      Include PCC post code capture drivers in the system configuration.

if PCC

source "drivers/pcc/Kconfig.ls"

module = PCC
module-str = pcc
source "subsys/logging/Kconfig.template.log_config"

config PCC_INIT_PRIORITY
    int "PCC driver init priority"
    default 10
    help
       PCC driver initialization priority.

endif
