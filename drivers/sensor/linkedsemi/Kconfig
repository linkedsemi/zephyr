# Linkedsemi CAP Sensor Driver Configuration

config CAP_LS
    bool "Linkedsemi CAP sensor driver"
    default y
    depends on SENSOR && PINCTRL
    depends on DT_HAS_LINKEDSEMI_LS_CAP_ENABLED
    help
      Enable the Linkedsemi CAP function sensor driver.

if CAP_LS


config CAP_V2
	bool "Enable CAP V2 mode support"
	default n
	help
	  Enable this option to add support for the newer QSH hardware variant
	  of the Linkedsemi CAP sensor. Leave disabled if using older hardware.

config CAP_LS_FETCH_TIMEOUT_MS
	int "CAP sample_fetch wait timeout in milliseconds"
	default 1000
	range 1 60000
	help
	  How long cap_sample_fetch waits for a capture-complete interrupt.
	  CAP does not raise an IRQ if the pin stays at a fixed level, so
	  this must not be infinite. Timed-out fetch returns -EAGAIN.

endif # CAP_LS
