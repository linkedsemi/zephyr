# Linkedsemi CAP Sensor Driver Configuration

config CAP_LS
    bool "Linkedsemi CAP sensor driver"
    default y
    depends on SENSOR && PINCTRL
    depends on DT_HAS_LINKEDSEMI_LS_CAP_ENABLED
    help
      Enable the Linkedsemi CAP function sensor driver.

if CAP_LS


config CAP_V2
	bool "Enable CAP V2 mode support"
	default n
	help
	  Enable this option to add support for the newer QSH hardware variant
	  of the Linkedsemi CAP sensor. Leave disabled if using older hardware.

endif # CAP_LS

config CASEOPEN_LS
	bool "Linkedsemi case-open (chassis intrusion) driver"
	default y
	depends on SENSOR
	depends on DT_HAS_LINKEDSEMI_CASEOPEN_ENABLED
	help
	  Enable the Linkedsemi case-open (chassis intrusion) detection
	  driver backed by the APP_PMU CASEOPEN_CTRL register.