config MBOX_LINKEDSEMI
	bool "MBOX LINKEDSEMI driver"
	depends on DT_HAS_LINKEDSEMI_MBOX_ENABLED
	default y
	help
	  MBOX Driver for LINKEDSEMI SOC

config MBOX_LINKEDSEMI_LAYOUT_CHECK
	bool "MBOX layout check"
	depends on MBOX_LINKEDSEMI
	default y
	help
	  Check the mbox layout in shared memory.  The initiator publishes
	  the shared info (magic, channel count and per-channel fifo config)
	  and both cores validate it against their own build-time layout at
	  init.

	  Both core images must set this option identically.  If the
	  initiator image disables it while the peer keeps it enabled, the
	  peer fails to initialize with -ENODEV because the shared info is
	  never published.

	  Disabling the check skips the cross-image validation, so a
	  devicetree mismatch between the two images (channel count, fifo
	  width/depth or shared region placement) is no longer detected.
