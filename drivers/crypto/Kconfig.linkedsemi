config CRYPTO_LINKEDSEMI_SHA256
    bool "linkedsemi SHA256 driver"
    depends on DT_HAS_LINKEDSEMI_SHA256_ENABLED
    default y
    help
      Enable linkedsemi SHA256 driver.

config CRYPTO_LINKEDSEMI_SHA512
    bool "linkedsemi SHA512 driver"
    depends on DT_HAS_LINKEDSEMI_SHA512_ENABLED
    default y
    help
      Enable linkedsemi SHA512 driver.

config SHA512_LINKEDSEMI_NO_CLOCK_RESET
	bool "Skip SHA512 CCTL/RCTL access in driver init"
	depends on CRYPTO_LINKEDSEMI_SHA512
	help
	  Skip clock_control and reset_line_toggle in sha512_linkedsemi_init.
	  Use when CCTL/RCTL is blocked by IOPMP.
	  Clock/reset must be handled elsewhere if this is enabled.
	  The clock/reset must then be handled on CPU1, for example with
	  ls_crypto_clock_prepare(LS_CRYPTO_CLK_SHA512) before CPU2 boots.

config SHA256_LINKEDSEMI_NO_CLOCK_RESET
	bool "Skip SHA256 CCTL/RCTL access in driver init"
	depends on CRYPTO_LINKEDSEMI_SHA256
	help
	  Skip clock_control and reset_line_toggle in sha256_linkedsemi_init.
	  Use when the SEC_SYSC_CPU clock/reset registers are owned by the
	  peer (security) core and are not accessible from this core.
	  The clock/reset must then be handled on CPU1, for example with
	  ls_crypto_clock_prepare(LS_CRYPTO_CLK_SHA256) before CPU2 boots.

config AES256_LINKEDSEMI_NO_CLOCK_RESET
	bool "Skip AES256 CCTL/RCTL access in driver init"
	depends on CRYPTO_LINKEDSEMI_AES256
	help
	  Skip clock_control and reset_line_toggle in
	  crypto_linkedsemi_aes256_init. Use when the SEC_SYSC_CPU
	  clock/reset registers are owned by the peer (security) core and
	  are not accessible from this core. The clock/reset must then be
	  handled on CPU1, for example with
	  ls_crypto_clock_prepare(LS_CRYPTO_CLK_AES256) before CPU2 boots.

config SM4_LINKEDSEMI_NO_CLOCK_RESET
	bool "Skip SM4 CCTL/RCTL access in driver init"
	depends on CRYPTO_LINKEDSEMI_SM4
	help
	  Skip clock_control and reset_line_toggle in sm4_linkedsemi_init.
	  Use when the SEC_SYSC_CPU clock/reset registers are owned by the
	  peer (security) core and are not accessible from this core.
	  The clock/reset must then be handled on CPU1, for example with
	  ls_crypto_clock_prepare(LS_CRYPTO_CLK_SM4) before CPU2 boots.

config CRYPTO_LINKEDSEMI_SM4
    bool "linkedsemi SM4 driver"
    depends on DT_HAS_LINKEDSEMI_SM4_ENABLED
    default y
    help
      Enable linkedsemi SM4 driver.

config CRYPTO_LINKEDSEMI_AES256
    bool "linkedsemi AES256 driver"
    default y
    depends on DT_HAS_LINKEDSEMI_AES256_ENABLED
    help
      Enable linkedsemi CRYPTO driver.

config CRYPTO_LINKEDSEMI_MAX_SESSION
    int "Maximum of sessions linkedsemi crypto driver can handle"
    default 1
    depends on CRYPTO_LINKEDSEMI
    help
      This can be used to tweak the amount of sessions the driver
      can handle in parallel.


config CRYPTO_LINKEDSEMI_OTBN
  bool "linkedsemi otbn driver"
  depends on DT_HAS_LINKEDSEMI_OTBN_CRYPTO_ENABLED

config CRYPTO_LINKEDSEMI_OTBN_SM2
  bool "linkedsemi otbn driver"
  select CRYPTO_LINKEDSEMI_OTBN
  default y
  depends on DT_HAS_LINKEDSEMI_OTBN_SM2_ENABLED

config CRYPTO_LINKEDSEMI_OTBN_ECC_P256
  bool "linkedsemi otbn driver"
  select CRYPTO_LINKEDSEMI_OTBN
  default y
  depends on DT_HAS_LINKEDSEMI_OTBN_ECC_P256_ENABLED

config CRYPTO_LINKEDSEMI_OTBN_ECC_P384
  bool "linkedsemi otbn driver"
  select CRYPTO_LINKEDSEMI_OTBN
  default y
  depends on DT_HAS_LINKEDSEMI_OTBN_ECC_P384_ENABLED