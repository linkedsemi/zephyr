config CRYPTO_LINKEDSEMI_SHA256
    bool "linkedsemi SHA256 driver"
    default y
    help
      Enable linkedsemi SHA256 driver.

config CRYPTO_LINKEDSEMI_SHA512
    bool "linkedsemi SHA512 driver"
    default y
    help
      Enable linkedsemi SHA512 driver.

config CRYPTO_LINKEDSEMI_SM4
    bool "linkedsemi SM4 driver"
    default y
    help
      Enable linkedsemi SM4 driver.

config CRYPTO_LINKEDSEMI
    bool "linkedsemi CRYPTO driver"
    default y
    depends on DT_HAS_LINKEDSEMI_CRYPTO_ENABLED
    help
      Enable linkedsemi CRYPTO driver.

config CRYPTO_LINKEDSEMI_MAX_SESSION
    int "Maximum of sessions linkedsemi crypto driver can handle"
    default 1
    depends on CRYPTO_LINKEDSEMI
    help
      This can be used to tweak the amount of sessions the driver
      can handle in parallel.
